---
/* A landing, em um lugar só.
 *
 * A raiz (`/`) e as rotas de origem (`/de/<ferramenta>`) servem exatamente esta página. A rota de
 * origem existe porque o Cloudflare Web Analytics conta por `Path` e NÃO tem dimensão de query
 * string: `?utm_source=` seria contado com a origem descartada. O caminho é o que responde "de
 * qual ferramenta esta visita veio".
 *
 * Por isso ela não é uma landing diferente — é a mesma, num endereço que o analytics sabe contar.
 * `canonical` aponta sempre para a raiz e a rota de origem sai do índice. A única diferença é
 * visual: o sistema daquela ferramenta chega marcado (ver o script no fim).
 *
 * `/en/` serve a mesma landing em inglês: a estrutura fica aqui e o texto em `src/i18n/landing.ts`.
 *
 * 🔴 As telas em `public/telas/` são capturas reais dos portais da Nipo (HML, clone de produção),
 * com clientes, vendedores, pessoas, fornecedores, valores e parceiros tarjados. Cada uma foi
 * conferida pelo José em 25/09/2026 antes de publicar. Tela nova passa pela mesma conferência.
 */
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { textos, type Idioma } from '../i18n/landing';

interface Props {
  /** `true` nas rotas de origem: elas são endereço de medição, não página para indexar. */
  noindex?: boolean;
  /** `pt` na raiz e nas rotas de origem; `en` em `/en/`. O texto vem de `src/i18n/landing.ts`. */
  idioma?: Idioma;
}

const { noindex = false, idioma = 'pt' } = Astro.props;
const t = textos[idioma];
const caminho = idioma === 'en' ? '/en/' : '/';

/* Só entra o que está no ar na Nipo; "homologação" é homologação, não produção.
 * `origens` liga o sistema às rotas `/de/<ferramenta>` que devem abri-lo marcado.
 * Aqui fica a estrutura; o texto de cada sistema, tela e nota vem do idioma, pela chave. */
const comTela = [
  {
    chave: 'logistica',
    situacao: 'producao',
    origens: ['nipo-logistica', 'nipo-produtividade', 'nipo-painel'],
    telas: [
      { nome: 'fluxo', w: 1600, h: 1000, notas: [{ x: 20, y: 42.2 }, { x: 46.8, y: 42.2 }] },
      { nome: 'armazenagem', w: 1600, h: 1081, notas: [{ x: 54.8, y: 33 }, { x: 57, y: 76 }] },
    ],
  },
  {
    chave: 'compras',
    situacao: 'producao',
    origens: ['nipo-compras'],
    telas: [
      { nome: 'compras', w: 1600, h: 1000, notas: [{ x: 62, y: 23.5 }, { x: 19, y: 38 }, { x: 59.2, y: 35.9 }] },
    ],
  },
] as const;

/* Numeração contínua dentro de cada sistema: o marcador na tela e o item da legenda ao lado.
 * Nota sem posição (ou posição sem nota) quebra o build: marcador mudo ou legenda sem marcador
 * só se veria olhando a página, e num idioma só. */
const numerados = comTela.map((s) => {
  const texto = t.sistemas[s.chave];
  let n = 0;
  const telas = s.telas.map((tela) => {
    const tt = (texto.telas as Record<string, { alt: string; legenda: string; notas: string[] }>)[tela.nome];
    if (!tt || tt.notas.length !== tela.notas.length) {
      throw new Error(`[${idioma}] tela ${tela.nome}: ${tela.notas.length} posições e ${tt?.notas.length ?? 0} notas`);
    }
    return { ...tela, alt: tt.alt, legenda: tt.legenda, notas: tela.notas.map((pos, i) => ({ ...pos, t: tt.notas[i], n: ++n })) };
  });
  return { ...s, sistema: texto.nome, texto: texto.texto, telas, notas: telas.flatMap((tela) => tela.notas) };
});

const semTela = ([
  { chave: 'fotos', situacao: 'producao', origens: ['nipo-fotos'] },
  { chave: 'rastreio', situacao: 'producao', origens: ['nipo-rastreio'] },
  { chave: 'dados', situacao: 'homologacao', origens: ['nipo-dados'] },
  { chave: 'vendas', situacao: 'homologacao', origens: ['nipo-vendas'] },
  { chave: 'atendimento', situacao: 'homologacao', origens: ['nipo-atendimento'] },
] as const).map((s) => ({ ...s, sistema: t.semTela[s.chave].nome, texto: t.semTela[s.chave].texto }));

const perguntas = t.perguntas.lista;

const SITE = 'https://carpelabs.io';
const url = `${SITE}${caminho}`;
const descricao = t.descricao;
/* A organização é a mesma nos dois idiomas (mesmo `@id`); o que muda é a página e o texto. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'carpe labs',
      alternateName: 'Carpe Labs',
      url: `${SITE}/`,
      logo: `${SITE}/icon-512.png`,
      email: 'contact@carpelabs.io',
      description: t.jsonLd.orgDescricao,
      address: { '@type': 'PostalAddress', addressRegion: 'SP', addressCountry: 'BR' },
      areaServed: { '@type': 'Country', name: t.jsonLd.pais },
      sameAs: ['https://github.com/CarpeLabs'],
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: 'contact@carpelabs.io', availableLanguage: ['pt-BR', 'en'] },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#site`,
      url: `${SITE}/`,
      name: 'carpe labs',
      inLanguage: ['pt-BR', 'en'],
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'Service',
      '@id': `${url}#servico`,
      name: t.jsonLd.servicoNome,
      serviceType: t.jsonLd.servicoTipo,
      description: descricao,
      provider: { '@id': `${SITE}/#org` },
      areaServed: { '@type': 'Country', name: t.jsonLd.pais },
      availableChannel: { '@type': 'ServiceChannel', serviceUrl: `${url}#contato`, availableLanguage: t.lang },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#perguntas`,
      inLanguage: t.lang,
      mainEntity: perguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
    },
  ],
};

const rotulo = (s: 'producao' | 'homologacao') => t.situacao[s];
const srcset = (nome: string) => `/telas/${nome}-960.webp 960w, /telas/${nome}-1600.webp 1600w`;
---

<!DOCTYPE html>
<html lang={t.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{t.titulo}</title>
    <meta name="description" content={descricao}>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="canonical" href={url}>
    {!noindex && <>
        <link rel="alternate" hreflang="pt-BR" href={`${SITE}/`}>
        <link rel="alternate" hreflang="en" href={`${SITE}/en/`}>
        <link rel="alternate" hreflang="x-default" href={`${SITE}/`}>
    </>}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="carpe labs">
    <meta property="og:locale" content={t.ogLocale}>
    <meta property="og:locale:alternate" content={textos[idioma === 'en' ? 'pt' : 'en'].ogLocale}>
    <meta property="og:url" content={url}>
    <meta property="og:title" content={t.titulo}>
    <meta property="og:description" content={descricao}>
    <meta property="og:image" content={`${SITE}${t.og.imagem}`}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={t.og.alt}>
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#fafaf9">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
        // Movimento de entrada. Fica no <head> e não no bundle de propósito: o CSS só esconde
        // o que vai animar quando `anima` está no <html>, e quem põe a classe é o mesmo script
        // que depois revela. Se ele não rodar, nada fica escondido.
        (function () {
            var d = document.documentElement;
            if (!('IntersectionObserver' in window)) return;
            d.classList.add('anima');
            document.addEventListener('DOMContentLoaded', function () {
                var olho = new IntersectionObserver(function (entradas) {
                    entradas.forEach(function (e) {
                        if (e.isIntersecting) { e.target.classList.add('visto'); olho.unobserve(e.target); }
                    });
                }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
                document.querySelectorAll('[data-anima]').forEach(function (el) { olho.observe(el); });

                // O topo fica fixo e ganha a régua quando a página sai do começo.
                var topo = document.querySelector('.topo');

                // Movimento ligado à rolagem: cada [data-rolagem] recebe --p (0 → 1) conforme passa
                // pela janela, e o CSS decide o que fazer com ele. Sem este script, ou com movimento
                // reduzido, --p fica no valor-padrão do CSS, que é o estado final.
                var reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
                var els = reduz ? [] : Array.prototype.slice.call(document.querySelectorAll('[data-rolagem]'));
                var pendente = false;
                var lim = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
                var suave = function (v) { return 1 - Math.pow(1 - v, 3); };
                var calcular = function () {
                    pendente = false;
                    var vh = innerHeight;
                    topo && topo.classList.toggle('rolou', scrollY > 8);
                    d.style.setProperty('--rolado', lim(scrollY / Math.max(1, d.scrollHeight - vh)).toFixed(4));
                    for (var i = 0; i < els.length; i++) {
                        var el = els[i], r = el.getBoundingClientRect(), tipo = el.getAttribute('data-rolagem'), p;
                        if (r.bottom < -vh || r.top > vh * 2) continue;
                        if (tipo === 'sai') p = lim(-r.top / (r.height * 0.85));
                        else if (tipo === 'faixa') p = lim((vh - r.top) / (vh + r.height));
                        else if (tipo === 'secao') p = suave(lim((vh - r.top) / (vh * 0.75)));
                        else p = suave(lim((vh - r.top) / (vh * 0.6)));
                        el.style.setProperty('--p', p.toFixed(4));
                    }
                };
                var pedir = function () { if (!pendente) { pendente = true; requestAnimationFrame(calcular); } };
                addEventListener('scroll', pedir, { passive: true });
                addEventListener('resize', pedir);
                calcular();
            });
        })();
    </script>
</head>
<body>
    <header class="topo">
        <a href={caminho} class="marca" aria-label={t.inicio}>
            <img src="/logo-papel.png" alt="" width="720" height="531">
        </a>
        <div class="topo-acoes">
            <a href={t.outroIdioma.href} class="idioma" hreflang={t.outroIdioma.lang} lang={t.outroIdioma.lang} aria-label={t.outroIdioma.rotulo}>{t.outroIdioma.texto}</a>
            <a href="#contato" class="topo-link">{t.abertura.acao}</a>
        </div>
    </header>

    <main>
        <section class="abertura" data-rolagem="sai" aria-labelledby="abertura-titulo">
            <div class="abertura-texto">
                <p class="em-uso"><span class="situacao situacao-producao">{t.abertura.emUso}</span><span class="em-uso-erp">{t.abertura.erp}</span></p>
                <h1 id="abertura-titulo">{t.abertura.titulo}</h1>
                <p class="abertura-apoio">{t.abertura.apoio}</p>
                <div class="abertura-acoes">
                    <a class="botao" href="#contato"><span>{t.abertura.acao}</span><svg class="seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    <a class="link" href="#caso"><span>{t.abertura.verCaso}</span><svg class="seta seta-baixo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
                </div>
            </div>
            <figure class="palco">
                <div class="palco-telas">
                    <img
                        class="palco-fundo"
                        src="/telas/fluxo-960.webp"
                        width="960" height="600"
                        alt="" aria-hidden="true">
                    <img
                        class="palco-frente"
                        src="/telas/produtividade-1600.webp"
                        srcset={srcset('produtividade')}
                        sizes="(min-width: 64rem) 55vw, 100vw"
                        width="1600" height="1000"
                        alt={t.abertura.palcoAlt}
                        fetchpriority="high">
                </div>
                <figcaption>{t.abertura.palcoLegenda}</figcaption>
            </figure>
        </section>

        <div class="faixa" data-rolagem="faixa" aria-hidden="true">
            <p class="faixa-linha faixa-sistemas">{[0, 1].map(() => numerados.map((c) => c.sistema).concat(semTela.map((c) => c.sistema)).map((n) => <span>{n}</span>))}</p>
            <p class="faixa-linha faixa-lema">{Array.from({ length: 6 }, () => <span>{t.faixaLema}</span>)}</p>
        </div>

        <section id="caso" class="caso" aria-labelledby="caso-titulo">
            <div class="caso-intro">
                <div class="caso-intro-texto" data-rolagem="sobe">
                    <h2 id="caso-titulo" data-anima="titulo">{t.caso.titulo}</h2>
                    <p>{t.caso.intro}</p>
                </div>

                <figure class="camadas" data-anima="camadas" aria-label={t.caso.camadas.rotulo}>
                    <div class="camada camada-ia">
                        <p class="camada-nome">{t.caso.camadas.ia.nome}</p>
                        <p class="camada-desc">{t.caso.camadas.ia.desc}</p>
                        <ul class="camada-itens"><li class="destaque">Claude</li><li class="destaque">ChatGPT</li><li class="outras">{t.caso.camadas.ia.outras}</li></ul>
                    </div>
                    <p class="camada-liga"><span>{t.caso.camadas.consulta}</span></p>
                    <div class="camada camada-portais">
                        <p class="camada-nome">{t.caso.camadas.portais.nome}</p>
                        <p class="camada-desc">{t.caso.camadas.portais.desc}</p>
                        <ul class="camada-itens">{t.caso.camadas.portais.itens.map((i) => <li>{i}</li>)}</ul>
                    </div>
                    <p class="camada-liga"><span>{t.caso.camadas.le}</span></p>
                    <div class="camada camada-erp">
                        <p class="camada-nome">{t.caso.camadas.erp.nome}</p>
                        <p class="camada-desc">{t.caso.camadas.erp.desc}</p>
                        <p class="camada-caso">{t.caso.camadas.erp.caso}</p>
                    </div>
                </figure>
            </div>

            {numerados.map((s) => (
                <article class="sistema" data-origens={s.origens.join(' ')}>
                    <div class="sistema-texto" data-anima="texto">
                        <h3>{s.sistema}</h3>
                        <p class={`situacao situacao-${s.situacao}`}>{rotulo(s.situacao)}</p>
                        <p class="sistema-uso">{s.texto}</p>
                        <ol class="notas">
                            {s.notas.map((nota) => (
                                <li data-n={nota.n}><span class="notas-n" aria-hidden="true">{nota.n}</span>{nota.t}</li>
                            ))}
                        </ol>
                    </div>
                    <div class="sistema-telas">
                        {s.telas.map((t) => (
                            <figure data-rolagem="cresce">
                                <div class="tela" data-anima="tela">
                                    <img
                                        src={`/telas/${t.nome}-1600.webp`}
                                        srcset={srcset(t.nome)}
                                        sizes="(min-width: 64rem) 65vw, 100vw"
                                        width={t.w} height={t.h}
                                        alt={t.alt}
                                        loading="lazy" decoding="async">
                                    {t.notas.map((nota) => (
                                        <span class="marcador" data-n={nota.n} style={`left: ${nota.x}%; top: ${nota.y}%; --ordem: ${nota.n}`} aria-hidden="true">{nota.n}</span>
                                    ))}
                                </div>
                                <figcaption>{t.legenda}</figcaption>
                            </figure>
                        ))}
                    </div>
                </article>
            ))}

            <div class="outros" data-rolagem="sobe">
                <h3>{t.caso.outros}</h3>
                <ul data-anima="lista">
                    {semTela.map((s) => (
                        <li data-origens={s.origens.join(' ')}>
                            <span class="outros-nome">{s.sistema}</span>
                            <span class="outros-uso">{s.texto}</span>
                            <span class={`situacao situacao-${s.situacao}`}>{rotulo(s.situacao)}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <section class="metodo" data-rolagem="secao" aria-labelledby="metodo-titulo">
            <h2 id="metodo-titulo" data-rolagem="sobe">{t.metodo.titulo}</h2>
            <div class="metodo-itens" data-anima="lista">
                {t.metodo.itens.map((m) => (
                    <div>
                        <h3>{m.titulo}</h3>
                        <p>{m.texto}</p>
                    </div>
                ))}
            </div>
        </section>

        <section id="perguntas" class="perguntas" aria-labelledby="perguntas-titulo">
            <h2 id="perguntas-titulo" data-anima="titulo">{t.perguntas.titulo}</h2>
            <div class="perguntas-lista" data-anima="lista">
                {perguntas.map((q) => (
                    <details>
                        <summary>{q.p}</summary>
                        <p>{q.r}</p>
                    </details>
                ))}
            </div>
        </section>

        <section id="contato" class="contato" data-rolagem="secao" aria-labelledby="contato-titulo">
          <div class="contato-grade">
            <div class="contato-intro">
                <h2 id="contato-titulo" data-anima="titulo">{t.contato.titulo}</h2>
                <p>{t.contato.intro}</p>
                <p class="contato-alt">{t.contato.alt} <a href="mailto:contact@carpelabs.io">contact@carpelabs.io</a></p>
            </div>

            <form id="contact-form" class="formulario" novalidate data-origem-marca={t.caso.origemMarca}>
                <div class="campo">
                    <label for="form-name">{t.contato.nome}</label>
                    <input type="text" name="name" id="form-name" autocomplete="name" required>
                    <p class="field-error" id="name-error">{t.contato.erroNome}</p>
                </div>
                <div class="campo">
                    <label for="form-email">{t.contato.email}</label>
                    <input type="email" name="email" id="form-email" autocomplete="email" required>
                    <p class="field-error" id="email-error">{t.contato.erroEmail}</p>
                </div>
                <div class="campo campo-largo">
                    <label for="form-message">{t.contato.mensagem}</label>
                    <textarea name="message" id="form-message" rows="5" required></textarea>
                    <p class="field-error" id="message-error">{t.contato.erroMensagem}</p>
                </div>

                <div class="envio">
                    <div class="cf-turnstile" data-sitekey="0x4AAAAAAEYqJuOOSujfYNYH" data-action="contato" data-theme="dark" data-language={t.contato.turnstile}></div>
                    <button type="submit" class="botao" id="submit-btn">
                        <span id="submit-text">{t.contato.enviar}</span><svg class="seta" id="submit-seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        <span id="submit-loading" class="hidden">{t.contato.enviando}</span>
                    </button>
                </div>

                <p id="form-success" class="form-message success hidden" role="status">{t.contato.sucesso}</p>
                <p id="form-error" class="form-message error hidden" role="alert">{t.contato.falha}</p>
            </form>
          </div>
        </section>
    </main>

    <footer class="rodape">
        <div class="rodape-entidade">
            <img src="/logo-papel.png" alt="carpe labs" width="720" height="531" class="rodape-marca">
            <p>{t.rodape.entidade}</p>
        </div>
        <nav aria-label={t.rodape.rotulo}>
            <a href="mailto:contact@carpelabs.io">contact@carpelabs.io</a>
            <a href="https://github.com/CarpeLabs" target="_blank" rel="noopener">GitHub</a>
            <a href="/privacidade/" hreflang="pt-BR">{t.rodape.privacidade}</a>
            <a href="/termos/" hreflang="pt-BR">{t.rodape.termos}</a>
        </nav>
    </footer>

    <script>
        // Quem chega por `/de/<ferramenta>` vê o sistema daquela ferramenta marcado.
        const daOrigem = location.pathname.match(/^\/de\/([a-z0-9-]+)/)?.[1];
        if (daOrigem) {
            const alvo = document.querySelector<HTMLElement>(`[data-origens~="${daOrigem}"]`);
            if (alvo) {
                alvo.classList.add('origem');
                const marca = document.createElement('span');
                marca.className = 'origem-marca';
                marca.textContent = document.getElementById('contact-form')?.dataset.origemMarca ?? '';
                alvo.querySelector('h3, .outros-nome')?.append(marca);
            }
        }

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const submitText = document.getElementById('submit-text');
        const submitLoading = document.getElementById('submit-loading');
        const nameInput = document.getElementById('form-name') as HTMLInputElement;
        const emailInput = document.getElementById('form-email') as HTMLInputElement;
        const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;
        const nameError = document.getElementById('name-error');
        const emailError = document.getElementById('email-error');
        const messageError = document.getElementById('message-error');
        const successMsg = document.getElementById('form-success');
        const errorMsg = document.getElementById('form-error');
        // O texto padrão de falha já vem no idioma da página; o script não traduz nada.
        const falhaPadrao = errorMsg?.textContent ?? '';
        const emPortugues = document.documentElement.lang.startsWith('pt');

        // Mesma origem: sem CORS, e por isso sem `no-cors` — a resposta volta legível.
        const ENDPOINT = '/api/contato';

        function validateField(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLElement | null) {
            const isValid = input.validity.valid;
            input.classList.toggle('invalid', !isValid);
            input.setAttribute('aria-invalid', String(!isValid));
            errorEl?.classList.toggle('visible', !isValid);
            return isValid;
        }

        for (const [input, errorEl] of [[nameInput, nameError], [emailInput, emailError], [messageInput, messageError]] as const) {
            input?.addEventListener('blur', () => validateField(input, errorEl));
            input?.addEventListener('input', () => { if (input.validity.valid) validateField(input, errorEl); });
        }

        form?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const isNameValid = validateField(nameInput, nameError);
            const isEmailValid = validateField(emailInput, emailError);
            const isMessageValid = validateField(messageInput, messageError);
            if (!isNameValid || !isEmailValid || !isMessageValid) {
                if (!isNameValid) nameInput?.focus();
                else if (!isEmailValid) emailInput?.focus();
                else messageInput?.focus();
                return;
            }

            successMsg?.classList.add('hidden');
            errorMsg?.classList.add('hidden');
            submitText?.classList.add('hidden');
            document.getElementById('submit-seta')?.classList.add('hidden');
            submitLoading?.classList.remove('hidden');
            if (submitBtn) submitBtn.disabled = true;

            const formData = new FormData(form);
            const data: Record<string, unknown> = {
                name: formData.get('name'),
                email: formData.get('email'),
                message: formData.get('message'),
                // O widget insere este campo no próprio form. Sem ele o endpoint devolve 403,
                // e é isso que se quer: sem prova, sem gravação.
                'cf-turnstile-response': formData.get('cf-turnstile-response'),
            };

            // A origem da visita (`/de/<ferramenta>`) viaja junto: é o que responde
            // "esse contato veio de qual ferramenta?" sem depender do analytics.
            // Na versão em inglês, a origem diz isso: o aviso chega marcado e a resposta sai no idioma certo.
            if (daOrigem) data.origem = daOrigem;
            else if (!emPortugues) data.origem = 'site-en';

            try {
                const response = await fetch(ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                });

                // 🔴 A resposta é LIDA. O código anterior usava `mode: 'no-cors'` e assumia
                // sucesso — foi assim que um 403 do endpoint virou "enviada com sucesso" na
                // tela por meses, sem ninguém saber quantas mensagens sumiram.
                if (!response.ok) {
                    // 400 traz a validação em português, feita para a pessoa ler. O resto (403 do
                    // Turnstile, 5xx) não diz nada a quem está do outro lado: vira a mensagem
                    // padrão, com o e-mail como saída. Na página em inglês, sempre a padrão.
                    const corpo = await response.json().catch(() => ({}));
                    const erro = (corpo as { erro?: string }).erro;
                    throw new Error(response.status === 400 && erro && emPortugues ? erro : '');
                }

                successMsg?.classList.remove('hidden');
                form.reset();
            } catch (error) {
                if (errorMsg) errorMsg.textContent = error instanceof Error && error.message
                    ? error.message
                    : falhaPadrao;
                errorMsg?.classList.remove('hidden');
            } finally {
                // 🔴 Token do Turnstile é de USO ÚNICO. O formulário continua na tela depois de um
                // erro, então sem rearmar o widget a segunda tentativa mandaria um token já
                // gasto — e a pessoa levaria 403 por um problema que não é dela.
                // Há um único widget na página, então `reset()` sem argumento é inequívoco.
                (window as { turnstile?: { reset(): void } }).turnstile?.reset();
                submitText?.classList.remove('hidden');
                document.getElementById('submit-seta')?.classList.remove('hidden');
                submitLoading?.classList.add('hidden');
                if (submitBtn) submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
