---
/* A landing, em um lugar só.
 *
 * A raiz (`/`) e as rotas de origem (`/de/<ferramenta>`) servem exatamente esta página. A rota de
 * origem existe porque o Cloudflare Web Analytics conta por `Path` e NÃO tem dimensão de query
 * string: `?utm_source=` seria contado com a origem descartada. O caminho é o que responde "de
 * qual ferramenta esta visita veio".
 *
 * Por isso ela não é uma landing diferente — é a mesma, num endereço que o analytics sabe contar.
 * `canonical` aponta sempre para a raiz e a rota de origem sai do índice. A única diferença é
 * visual: o sistema daquela ferramenta chega marcado (ver o script no fim).
 *
 * `/en/` serve a mesma landing em inglês: a estrutura fica aqui e o texto em `src/i18n/landing.ts`.
 *
 * A página não mostra capturas de tela: o caso Nipo é contado pelo que muda na operação.
 */
import '@fontsource-variable/hanken-grotesk';
// A fonte latina é pedida já no HTML, sem esperar o CSS descobri-la.
import fonteLatina from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { textos, type Idioma } from '../i18n/landing';

interface Props {
  /** `true` nas rotas de origem: elas são endereço de medição, não página para indexar. */
  noindex?: boolean;
  /** `pt` na raiz e nas rotas de origem; `en` em `/en/`. O texto vem de `src/i18n/landing.ts`. */
  idioma?: Idioma;
}

const { noindex = false, idioma = 'pt' } = Astro.props;
const t = textos[idioma];
const caminho = idioma === 'en' ? '/en/' : '/';

/* Os resultados da Nipo, na ordem da página, em dois grupos: onde a IA já trabalha (o assistente
 * abre em destaque) e a base de dados organizada por área, que é o que a IA consulta.
 * `origens` liga o resultado às rotas `/de/<ferramenta>` que devem abri-lo marcado.
 * Só entra em `comIa` o que de fato usa IA na Nipo. Aqui fica a ordem; o texto vem do idioma. */
const comIa = ([
  { chave: 'dados', origens: ['nipo-dados'], destaque: true },
  { chave: 'atendimento', origens: ['nipo-atendimento'] },
  { chave: 'fotos', origens: ['nipo-fotos'] },
  { chave: 'compras', origens: ['nipo-compras'] },
  { chave: 'vendas', origens: ['nipo-vendas'] },
] as const).map((r) => ({ ...r, ...t.resultados.itens[r.chave] }));
const base = ([
  { chave: 'logistica', origens: ['nipo-logistica', 'nipo-produtividade', 'nipo-painel'] },
  { chave: 'rastreio', origens: ['nipo-rastreio'] },
] as const).map((r) => ({ ...r, ...t.resultados.itens[r.chave] }));

/* O diagrama do fluxo (viewBox 640×560): seis fontes em duas colunas alimentam a IA no centro, que
 * devolve respostas e tarefas embaixo. As curvas saem da borda de cada cartão e chegam à borda do
 * círculo; as partículas correm por elas (SMIL `animateMotion`, que funciona em todo navegador). */
const centro = { x: 320, y: 250, r: 74 };
const fontes = t.fluxo.fontes.map((nome, i) => {
  const esquerda = i < 3;
  const x = esquerda ? 86 : 554;
  const y = [90, 250, 410][i % 3];
  const borda = esquerda ? x + 82 : x - 82;
  const meio = esquerda ? 232 : 408;
  const fim = esquerda ? centro.x - centro.r - 4 : centro.x + centro.r + 4;
  /* Cor de cada ferramenta, em bloco com símbolo genérico (sem logotipo de terceiros). */
  const cor = ['#1f7a4d', '#2b5fb4', '#d0542b', '#6b4fbb', '#0f84c8', '#d33b32'][i];
  return { nome, i, x, y, cor, d: `M${borda},${y} C${meio},${y} ${meio},${centro.y} ${fim},${centro.y}` };
});

const perguntas = t.perguntas.lista;

const SITE = 'https://carpelabs.io';
const url = `${SITE}${caminho}`;
const descricao = t.descricao;
/* A organização é a mesma nos dois idiomas (mesmo `@id`); o que muda é a página e o texto. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'Carpe Labs',
      alternateName: 'carpe labs',
      url: `${SITE}/`,
      logo: `${SITE}/icon-512.png`,
      email: 'contact@carpelabs.io',
      description: t.jsonLd.orgDescricao,
      address: { '@type': 'PostalAddress', addressRegion: 'SP', addressCountry: 'BR' },
      areaServed: { '@type': 'Country', name: t.jsonLd.pais },
      knowsAbout: t.jsonLd.temas,
      sameAs: ['https://github.com/CarpeLabs'],
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: 'contact@carpelabs.io', availableLanguage: ['pt-BR', 'en'] },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#site`,
      url: `${SITE}/`,
      name: 'Carpe Labs',
      inLanguage: ['pt-BR', 'en'],
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'Service',
      '@id': `${url}#servico`,
      name: t.jsonLd.servicoNome,
      serviceType: t.jsonLd.servicoTipo,
      description: descricao,
      provider: { '@id': `${SITE}/#org` },
      areaServed: { '@type': 'Country', name: t.jsonLd.pais },
      availableChannel: { '@type': 'ServiceChannel', serviceUrl: `${url}#contato`, availableLanguage: t.lang },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#perguntas`,
      inLanguage: t.lang,
      mainEntity: perguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
    },
  ],
};

/* Títulos entram palavra por palavra: cada palavra vira um <span> com a ordem em `--i`. */
const palavras = (texto: string) => texto.split(' ').map((w, i) => ({ w, i }));

---

<!DOCTYPE html>
<html lang={t.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{t.titulo}</title>
    <meta name="description" content={descricao}>
    <link rel="preload" href={fonteLatina} as="font" type="font/woff2" crossorigin>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="canonical" href={url}>
    {!noindex && <>
        <link rel="alternate" hreflang="pt-BR" href={`${SITE}/`}>
        <link rel="alternate" hreflang="en" href={`${SITE}/en/`}>
        <link rel="alternate" hreflang="x-default" href={`${SITE}/`}>
    </>}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Carpe Labs">
    <meta property="og:locale" content={t.ogLocale}>
    <meta property="og:locale:alternate" content={textos[idioma === 'en' ? 'pt' : 'en'].ogLocale}>
    <meta property="og:url" content={url}>
    <meta property="og:title" content={t.titulo}>
    <meta property="og:description" content={descricao}>
    <meta property="og:image" content={`${SITE}${t.og.imagem}`}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={t.og.alt}>
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#f4f4f1">
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
        // Turnstile só quando o formulário se aproxima (ou recebe foco): a maioria das visitas não
        // chega ao contato, e o script de terceiro saía do caminho de toda carga de página.
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('contact-form');
            if (!form) return;
            var carregado = false;
            function carrega() {
                if (carregado) return;
                carregado = true;
                var s = document.createElement('script');
                s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
                s.async = true;
                document.head.appendChild(s);
            }
            form.addEventListener('focusin', carrega, { once: true });
            if (!('IntersectionObserver' in window)) return carrega();
            var perto = new IntersectionObserver(function (entradas) {
                if (entradas.some(function (e) { return e.isIntersecting; })) { carrega(); perto.disconnect(); }
            }, { rootMargin: '800px 0px' });
            perto.observe(form);
        });
    </script>
    <script is:inline>
        // Movimento de entrada. Fica no <head> e não no bundle de propósito: o CSS só esconde
        // o que vai animar quando `anima` está no <html>, e quem põe a classe é o mesmo script
        // que depois revela. Se ele não rodar, nada fica escondido.
        (function () {
            var d = document.documentElement;
            if (!('IntersectionObserver' in window)) return;
            d.classList.add('anima');
            document.addEventListener('DOMContentLoaded', function () {
                var olho = new IntersectionObserver(function (entradas) {
                    entradas.forEach(function (e) {
                        if (e.isIntersecting) { e.target.classList.add('visto'); olho.unobserve(e.target); }
                    });
                }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
                document.querySelectorAll('[data-anima]:not([data-anima="secao"])').forEach(function (el) { olho.observe(el); });
                // Os blocos entram inteiros, de uma vez, assim que a borda de cima passa um pouco do
                // fim da tela; um limiar por área atrasaria demais os blocos altos.
                var olhoBloco = new IntersectionObserver(function (entradas) {
                    entradas.forEach(function (e) {
                        if (e.isIntersecting) { e.target.classList.add('visto'); olhoBloco.unobserve(e.target); }
                    });
                }, { rootMargin: '0px 0px -12% 0px' });
                document.querySelectorAll('[data-anima="secao"]').forEach(function (el) { olhoBloco.observe(el); });

                // O botão do header só aparece quando o da abertura sai da tela.
                var cta = document.querySelector('.abertura-acoes .botao');
                if (cta) new IntersectionObserver(function (entradas) {
                    d.classList.toggle('cta-a-vista', entradas[0].isIntersecting);
                }, { rootMargin: '-80px 0px 0px 0px' }).observe(cta);

                // O peixe da abertura voa até o header conforme a página desce: o `.simbolo` fica no
                // fluxo como lugar reservado, e o `.peixe` (fixo) é interpolado entre esse lugar e o
                // encaixe do header. Com movimento reduzido, ele troca de lugar sem o voo.
                var vaga = document.querySelector('.simbolo');
                var peixe = document.querySelector('.peixe');
                var encaixe = document.querySelector('.topo-slot');
                var reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (vaga && peixe && encaixe) {
                    d.classList.add('voa');
                    var pend = false;
                    var voar = function () {
                        pend = false;
                        var a = vaga.getBoundingClientRect(), b = encaixe.getBoundingClientRect();
                        var lim = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
                        // O peixe rola junto com a página, como qualquer conteúdo. Quando a vaga dele
                        // passa do topo, ele fica preso ali e encolhe na mesma medida em que a vaga sai:
                        // nunca fica maior que o pedaço da vaga ainda visível, então não cobre o texto
                        // nem deixa um vão. Pousa no header quando atinge o tamanho do logo.
                        var sb = b.width / a.width;
                        var k = b.top - a.top;
                        var p = k > 0 ? lim(k / (a.height * (1 - sb))) : 0;
                        if (reduz) p = p > 0.5 ? 1 : 0;
                        // O deslize lateral fica para a segunda metade, quando o peixe já está pequeno:
                        // grande, ele só encolhe dentro da própria vaga.
                        var q = lim((p - 0.5) / 0.5), e = q * q * (3 - 2 * q);
                        var x = a.left + (b.left - a.left) * e, y = p > 0 ? b.top : a.top;
                        var s = 1 - p * (1 - sb);
                        var giro = Math.sin(Math.PI * p) * -6;
                        var pousa = p >= 1;
                        peixe.style.width = a.width + 'px';
                        peixe.style.transform = 'translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px) scale(' + s.toFixed(4) + ') rotate(' + giro.toFixed(2) + 'deg)';
                        d.classList.toggle('pousou', pousa);
                    };
                    var pedir = function () { if (!pend) { pend = true; requestAnimationFrame(voar); } };
                    addEventListener('scroll', pedir, { passive: true });
                    addEventListener('resize', pedir);
                    voar();
                }

                // A montagem do fluxo acompanha a rolagem: `--p` vai de 0, quando o diagrama encosta no
                // pé da tela, a 1, quando o meio dele chega um pouco abaixo do centro.
                var figuraP = document.querySelector('.fluxo-figura');
                if (figuraP) {
                    var pendF = false;
                    var montar = function () {
                        pendF = false;
                        var r = figuraP.getBoundingClientRect();
                        var p = reduz ? 1 : (innerHeight - r.top) / (innerHeight * 0.4 + r.height * 0.5);
                        figuraP.style.setProperty('--p', (p < 0 ? 0 : p > 1 ? 1 : p).toFixed(3));
                    };
                    addEventListener('scroll', function () { if (!pendF) { pendF = true; requestAnimationFrame(montar); } }, { passive: true });
                    addEventListener('resize', montar);
                    montar();
                }

                // O diagrama do fluxo só se move enquanto está na tela; com movimento reduzido, fica parado.
                var figura = document.querySelector('.fluxo-figura');
                var svgFluxo = figura && figura.querySelector('svg');
                if (svgFluxo && svgFluxo.pauseAnimations) {
                    if (reduz) svgFluxo.pauseAnimations();
                    else new IntersectionObserver(function (entradas) {
                        var ve = entradas[0].isIntersecting;
                        figura.classList.toggle('parado', !ve);
                        if (ve) svgFluxo.unpauseAnimations(); else svgFluxo.pauseAnimations();
                    }).observe(figura);
                }

                // O peixe acompanha o cursor de leve, só enquanto está na abertura.
                if (peixe && matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
                    addEventListener('pointermove', function (e) {
                        peixe.style.setProperty('--mx', ((e.clientX / innerWidth) - 0.5).toFixed(3));
                        peixe.style.setProperty('--my', ((e.clientY / innerHeight) - 0.5).toFixed(3));
                    }, { passive: true });
                }
            });
        })();
    </script>
</head>
<body>
<Fragment set:html={'<!--email_off-->'} />
    {/* O header só aparece quando o peixe da abertura pousa nele (ver o script do <head>). */}
    <header class="topo">
        <a href={caminho} class="topo-marca" aria-label={t.inicio}><span class="topo-slot"></span><span class="topo-nome" aria-hidden="true">carpe labs</span></a>
        <div class="topo-acoes">
            <a href={t.outroIdioma.href} class="idioma" hreflang={t.outroIdioma.lang} lang={t.outroIdioma.lang} aria-label={t.outroIdioma.rotulo}>{t.outroIdioma.texto}</a>
            <a href="#contato" class="topo-link">{t.abertura.acao}</a>
        </div>
    </header>

    <main>
        <section class="abertura" aria-labelledby="abertura-titulo">
            <div class="abertura-texto">
                <h1 id="abertura-titulo" class="palavras">{palavras(t.abertura.titulo).map(({ w, i }) => <><span class:list={['p', { forte: w === 'IA' || w === 'AI' }]} style={`--i:${i}`}>{w}</span>{' '}</>)}</h1>
                <p class="abertura-apoio">{t.abertura.apoio}</p>
                <div class="abertura-acoes">
                    <a class="botao" href="#contato"><span>{t.ia.acao}</span><svg class="seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    <a class="link" href="#resultados"><span>{t.abertura.verCaso}</span></a>
                </div>
            </div>
            <div class="simbolo" aria-hidden="true">
              <div class="peixe">
                {/* O peixe do logo, redesenhado em vetor sobre `public/logo.png` para poder se desenhar. */}
                <svg viewBox="480 470 930 680" fill="none" stroke="currentColor" stroke-width="48">
                    <path class="traco" pathLength="1" d="M512 848 C650 702 955 628 1165 765"/>
                    <path class="traco" pathLength="1" d="M1325 668 C1290 820 1150 960 958 985"/>
                    <path class="traco" pathLength="1" d="M828 962 C860 1050 920 1100 1000 1108"/>
                    <path class="cheio" fill="currentColor" stroke="none" fill-rule="evenodd" d="M826 648 C880 568 955 520 1045 497 C1028 570 1035 635 1080 688 L826 648 Z M890 645 C925 610 955 588 985 573 C988 610 993 637 1003 660 Z"/>
                    <circle class="cheio olho" cx="713" cy="820" r="35" fill="currentColor" stroke="none"/>
                    <circle class="cheio" cx="1320" cy="928" r="57" fill="currentColor" stroke="none"/>
                </svg>
              </div>
            </div>
            <ol id="ia" class="abertura-passos" data-anima="lista">
                {t.ia.passos.map((passo, i) => (
                    <li>
                        <span class="passo-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <h2>{passo.titulo}</h2>
                        <p>{passo.texto}</p>
                    </li>
                ))}
            </ol>
        </section>

        <section id="fluxo" class="fluxo" data-anima="secao" aria-labelledby="fluxo-titulo">
            <div class="fluxo-texto">
                <h2 id="fluxo-titulo" class="palavras" data-anima="titulo">{palavras(t.fluxo.titulo).map(({ w, i }) => <><span class:list={['p', { forte: w === 'IA' || w === 'AI' }]} style={`--i:${i}`}>{w}</span>{' '}</>)}</h2>
                <p>{t.fluxo.texto}</p>
            </div>
            <figure class="fluxo-figura">
                <svg viewBox="0 0 640 560" role="img" aria-label={t.fluxo.rotulo}>
                    {/* Linhas de base: desenham-se quando o bloco entra. */}
                    <g class="fluxo-linhas" fill="none">
                        {fontes.map((f) => <path id={`fluxo-${f.i}`} d={f.d} pathLength="1" style={`--i:${f.i}`} />)}
                        <path id="fluxo-saida" d={`M${centro.x},${centro.y + centro.r + 4} L${centro.x},464`} pathLength="1" style="--i:6" />
                    </g>
                    {/* Partículas: os dados chegando à IA e as respostas saindo. */}
                    <g class="fluxo-particulas">
                        {fontes.map((f) => [0, 1].map((k) => (
                            <circle r="4.5">
                                <animateMotion dur="2.6s" repeatCount="indefinite" begin={`-${(f.i * 0.43 + k * 1.3).toFixed(2)}s`} calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.55 1">
                                    <mpath href={`#fluxo-${f.i}`} />
                                </animateMotion>
                            </circle>
                        )))}
                        {[0, 1, 2].map((k) => (
                            <circle r="5.5" class="saindo">
                                <animateMotion dur="1.6s" repeatCount="indefinite" begin={`-${(k * 0.53).toFixed(2)}s`}>
                                    <mpath href="#fluxo-saida" />
                                </animateMotion>
                            </circle>
                        ))}
                    </g>
                    {/* A IA no centro: órbitas girando e um pulso contínuo. */}
                    <g class="fluxo-centro">
                        <circle class="orbita orbita-1" cx={centro.x} cy={centro.y} r="100" />
                        <circle class="orbita orbita-2" cx={centro.x} cy={centro.y} r="124" />
                        <circle class="pulso" cx={centro.x} cy={centro.y} r={centro.r} />
                        <circle class="nucleo" cx={centro.x} cy={centro.y} r={centro.r} />
                        <text x={centro.x} y={centro.y} text-anchor="middle" dominant-baseline="central">{idioma === 'en' ? 'AI' : 'IA'}</text>
                    </g>
                    {/* As fontes, em cartões com ícone genérico e o nome. */}
                    {fontes.map((f) => (
                        <g class="fonte" style={`--i:${f.i}; --lado:${f.i < 3 ? -1 : 1}`} transform={`translate(${f.x} ${f.y})`}>
                            <rect class="fonte-cartao" x="-82" y="-44" width="164" height="88" rx="16" />
                            <rect class="fonte-bloco" x="-18" y="-34" width="36" height="36" rx="10" fill={f.cor} />
                            <g class="fonte-icone" transform="translate(0 -16) scale(0.62)" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                {f.i === 0 && <><path d="M-11,-15 h15 l7,7 v23 h-22 z M4,-15 v7 h7" /><path d="M-7,-2 h14 M-7,4 h14 M-7,10 h14 M0,-6 v18" /></>}
                                {f.i === 1 && <><path d="M-11,-15 h15 l7,7 v23 h-22 z M4,-15 v7 h7" /><path d="M-7,-3 h10 M-7,2 h14 M-7,7 h14 M-7,12 h9" /></>}
                                {f.i === 2 && <><rect x="-15" y="-12" width="30" height="21" rx="2.5" /><path d="M-8,4 v-5 M-2,4 v-9 M4,4 v-3 M0,9 v6 M-6,15 h12" /></>}
                                {f.i === 3 && <><ellipse cx="0" cy="-10" rx="13" ry="4.5" /><path d="M-13,-10 v20 c0,6 26,6 26,0 v-20 M-13,0 c0,6 26,6 26,0" /></>}
                                {f.i === 4 && <><rect x="-15" y="-10" width="30" height="21" rx="2.5" /><path d="M-15,-9 L0,3 L15,-9" /></>}
                                {f.i === 5 && <><path d="M-11,-15 h15 l7,7 v23 h-22 z M4,-15 v7 h7" /><path d="M-7,4 h14 M-7,10 h9" /><path d="M-7,-4 h6" /></>}
                            </g>
                            <text y="26" text-anchor="middle">{f.nome}</text>
                        </g>
                    ))}
                    {/* O que sai: respostas e tarefas. */}
                    <g class="fluxo-resultado" style="--i:7">
                        <rect x="190" y="466" width="260" height="56" rx="28" />
                        <text x="320" y="494" text-anchor="middle" dominant-baseline="central">{t.fluxo.saida}</text>
                    </g>
                </svg>
            </figure>
        </section>

        <section id="resultados" class="resultados" data-anima="secao" aria-labelledby="resultados-titulo">
            <div class="secao-cabeca">
                <h2 id="resultados-titulo" class="palavras" data-anima="titulo">{palavras(t.resultados.titulo).map(({ w, i }) => <><span class="p" style={`--i:${i}`}>{w}</span>{' '}</>)}</h2>
                <p>{t.resultados.intro}</p>
            </div>
            <ol class="resultados-lista" data-anima="lista">
                {comIa.map((r) => (
                    <li class:list={['resultado', { 'resultado-destaque': 'destaque' in r }]} data-origens={r.origens.join(' ')}>
                        <div class="resultado-corpo">
                            <h3>{r.titulo}</h3>
                            <p>{r.texto}</p>
                        </div>
                        <p class="resultado-meta">{r.sistema}</p>
                    </li>
                ))}
            </ol>
            <div class="resultados-grupo" data-anima="titulo">
                <h3>{t.resultados.base.titulo}</h3>
                <p>{t.resultados.base.texto}</p>
            </div>
            <ol class="resultados-base" data-anima="lista">
                {base.map((r) => (
                    <li class="resultado resultado-base" data-origens={r.origens.join(' ')}>
                        <p class="resultado-area">{r.sistema}</p>
                        <div class="resultado-corpo">
                            <h3>{r.titulo}</h3>
                            <p>{r.texto}</p>
                        </div>
                    </li>
                ))}
            </ol>
        </section>

        <section class="metodo" data-anima="secao" aria-labelledby="metodo-titulo">
            <h2 id="metodo-titulo" class="palavras" data-anima="titulo">{palavras(t.metodo.titulo).map(({ w, i }) => <><span class="p" style={`--i:${i}`}>{w}</span>{' '}</>)}</h2>
            <div class="metodo-itens" data-anima="lista">
                {t.metodo.itens.map((m) => (
                    <div>
                        <h3>{m.titulo}</h3>
                        <p>{m.texto}</p>
                    </div>
                ))}
            </div>
        </section>

        <section id="perguntas" class="perguntas" data-anima="secao" aria-labelledby="perguntas-titulo">
            <h2 id="perguntas-titulo" class="palavras" data-anima="titulo">{palavras(t.perguntas.titulo).map(({ w, i }) => <><span class="p" style={`--i:${i}`}>{w}</span>{' '}</>)}</h2>
            <div class="perguntas-lista" data-anima="lista">
                {perguntas.map((q) => (
                    <details>
                        <summary>{q.p}</summary>
                        <p>{q.r}</p>
                    </details>
                ))}
            </div>
        </section>

        <section id="contato" class="contato" data-anima="secao" aria-labelledby="contato-titulo">
            <div class="contato-intro">
                <h2 id="contato-titulo" class="palavras" data-anima="titulo">{palavras(t.contato.titulo).map(({ w, i }) => <><span class="p" style={`--i:${i}`}>{w}</span>{' '}</>)}</h2>
                <p>{t.contato.intro}</p>
            </div>

            <form id="contact-form" class="formulario" data-anima="lista" novalidate data-origem-marca={t.caso.origemMarca}>
                <div class="campo">
                    <label for="form-name">{t.contato.nome}</label>
                    <input type="text" name="name" id="form-name" autocomplete="name" required>
                    <p class="field-error" id="name-error">{t.contato.erroNome}</p>
                </div>
                <div class="campo">
                    <label for="form-email">{t.contato.email}</label>
                    <input type="email" name="email" id="form-email" autocomplete="email" required>
                    <p class="field-error" id="email-error">{t.contato.erroEmail}</p>
                </div>
                <div class="campo campo-largo">
                    <label for="form-message">{t.contato.mensagem}</label>
                    <textarea name="message" id="form-message" rows="3" maxlength="4500" required></textarea>
                    <p class="field-error" id="message-error">{t.contato.erroMensagem}</p>
                </div>

                <div class="envio">
                    <div class="cf-turnstile" data-sitekey="0x4AAAAAAEYqJuOOSujfYNYH" data-action="contato" data-theme="light" data-appearance="interaction-only" data-language={t.contato.turnstile}></div>
                    <button type="submit" class="botao" id="submit-btn">
                        <span id="submit-text">{t.contato.enviar}</span><svg class="seta" id="submit-seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        <span id="submit-loading" class="hidden">{t.contato.enviando}</span>
                    </button>
                </div>

                <p id="form-success" class="form-message success hidden" role="status">{t.contato.sucesso}</p>
                <p id="form-error" class="form-message error hidden" role="alert">{t.contato.falha}</p>
            </form>
        </section>
    </main>

    <footer class="rodape" data-anima="secao">
        <div class="rodape-topo">
            <a href={caminho} class="rodape-marca" aria-label={t.inicio}>
                <svg viewBox="480 470 930 680" fill="none" stroke="currentColor" stroke-width="48" aria-hidden="true">
                    <path d="M512 848 C650 702 955 628 1165 765"/>
                    <path d="M1325 668 C1290 820 1150 960 958 985"/>
                    <path d="M828 962 C860 1050 920 1100 1000 1108"/>
                    <path fill="currentColor" stroke="none" fill-rule="evenodd" d="M826 648 C880 568 955 520 1045 497 C1028 570 1035 635 1080 688 L826 648 Z M890 645 C925 610 955 588 985 573 C988 610 993 637 1003 660 Z"/>
                    <circle cx="713" cy="820" r="35" fill="currentColor" stroke="none"/>
                    <circle cx="1320" cy="928" r="57" fill="currentColor" stroke="none"/>
                </svg>
                <span>carpe labs</span>
            </a>
            <nav aria-label={t.rodape.rotulo}>
                <a href="mailto:contact@carpelabs.io">contact@carpelabs.io</a>
                <a href="https://github.com/CarpeLabs" target="_blank" rel="noopener">GitHub</a>
                <a href="/privacidade/" hreflang="pt-BR">{t.rodape.privacidade}</a>
                <a href="/termos/" hreflang="pt-BR">{t.rodape.termos}</a>
                <a href={t.outroIdioma.href} hreflang={t.outroIdioma.lang} lang={t.outroIdioma.lang}>{t.outroIdioma.texto}</a>
            </nav>
        </div>
        <div class="rodape-base">
            <p class="rodape-ano">© {new Date().getFullYear()} Carpe Labs</p>
        </div>
    </footer>

    <script>
        // Quem chega por `/de/<ferramenta>` vê o sistema daquela ferramenta marcado.
        const daOrigem = location.pathname.match(/^\/de\/([a-z0-9-]+)/)?.[1];
        if (daOrigem) {
            const alvo = document.querySelector<HTMLElement>(`[data-origens~="${daOrigem}"]`);
            if (alvo) {
                alvo.classList.add('origem');
                const marca = document.createElement('span');
                marca.className = 'origem-marca';
                marca.textContent = document.getElementById('contact-form')?.dataset.origemMarca ?? '';
                alvo.querySelector('h3')?.append(marca);
            }
        }

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const submitText = document.getElementById('submit-text');
        const submitLoading = document.getElementById('submit-loading');
        const nameInput = document.getElementById('form-name') as HTMLInputElement;
        const emailInput = document.getElementById('form-email') as HTMLInputElement;
        const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;
        const nameError = document.getElementById('name-error');
        const emailError = document.getElementById('email-error');
        const messageError = document.getElementById('message-error');
        const successMsg = document.getElementById('form-success');
        const errorMsg = document.getElementById('form-error');
        // O texto padrão de falha já vem no idioma da página; o script não traduz nada.
        const falhaPadrao = errorMsg?.textContent ?? '';
        const emPortugues = document.documentElement.lang.startsWith('pt');

        // Mesma origem: sem CORS, e por isso sem `no-cors` — a resposta volta legível.
        const ENDPOINT = '/api/contato';

        function validateField(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLElement | null) {
            const isValid = input === messageInput ? input.value.trim() !== '' : input.validity.valid;
            input.classList.toggle('invalid', !isValid);
            input.setAttribute('aria-invalid', String(!isValid));
            errorEl?.classList.toggle('visible', !isValid);
            return isValid;
        }

        for (const [input, errorEl] of [[nameInput, nameError], [emailInput, emailError], [messageInput, messageError]] as const) {
            input?.addEventListener('blur', () => validateField(input, errorEl));
            input?.addEventListener('input', () => { if (input.validity.valid) validateField(input, errorEl); });
        }
        form?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const isNameValid = validateField(nameInput, nameError);
            const isEmailValid = validateField(emailInput, emailError);
            const isMessageValid = validateField(messageInput, messageError);
            if (!isNameValid || !isEmailValid || !isMessageValid) {
                if (!isNameValid) nameInput?.focus();
                else if (!isEmailValid) emailInput?.focus();
                else messageInput?.focus();
                return;
            }

            successMsg?.classList.add('hidden');
            errorMsg?.classList.add('hidden');
            submitText?.classList.add('hidden');
            document.getElementById('submit-seta')?.classList.add('hidden');
            submitLoading?.classList.remove('hidden');
            if (submitBtn) submitBtn.disabled = true;

            const formData = new FormData(form);
            const data: Record<string, unknown> = {
                name: formData.get('name'),
                email: formData.get('email'),
                message: String(formData.get('message') ?? '').trim(),
                // O widget insere este campo no próprio form. Sem ele o endpoint devolve 403,
                // e é isso que se quer: sem prova, sem gravação.
                'cf-turnstile-response': formData.get('cf-turnstile-response'),
            };

            // A origem da visita (`/de/<ferramenta>`) viaja junto: é o que responde
            // "esse contato veio de qual ferramenta?" sem depender do analytics.
            // Na versão em inglês, a origem diz isso: o aviso chega marcado e a resposta sai no idioma certo.
            if (daOrigem) data.origem = daOrigem;
            else if (!emPortugues) data.origem = 'site-en';

            try {
                const response = await fetch(ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                });

                // 🔴 A resposta é LIDA. O código anterior usava `mode: 'no-cors'` e assumia
                // sucesso — foi assim que um 403 do endpoint virou "enviada com sucesso" na
                // tela por meses, sem ninguém saber quantas mensagens sumiram.
                if (!response.ok) {
                    // 400 traz a validação em português, feita para a pessoa ler. O resto (403 do
                    // Turnstile, 5xx) não diz nada a quem está do outro lado: vira a mensagem
                    // padrão, com o e-mail como saída. Na página em inglês, sempre a padrão.
                    const corpo = await response.json().catch(() => ({}));
                    const erro = (corpo as { erro?: string }).erro;
                    throw new Error(response.status === 400 && erro && emPortugues ? erro : '');
                }

                successMsg?.classList.remove('hidden');
                form.reset();
            } catch (error) {
                if (errorMsg) errorMsg.textContent = error instanceof Error && error.message
                    ? error.message
                    : falhaPadrao;
                errorMsg?.classList.remove('hidden');
            } finally {
                // 🔴 Token do Turnstile é de USO ÚNICO. O formulário continua na tela depois de um
                // erro, então sem rearmar o widget a segunda tentativa mandaria um token já
                // gasto — e a pessoa levaria 403 por um problema que não é dela.
                // Há um único widget na página, então `reset()` sem argumento é inequívoco.
                (window as { turnstile?: { reset(): void } }).turnstile?.reset();
                submitText?.classList.remove('hidden');
                document.getElementById('submit-seta')?.classList.remove('hidden');
                submitLoading?.classList.add('hidden');
                if (submitBtn) submitBtn.disabled = false;
            }
        });
    </script>
<Fragment set:html={'<!--email_on-->'} />
</body>
</html>
