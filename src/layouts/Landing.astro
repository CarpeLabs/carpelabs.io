---
/* A landing, em um lugar só.
 *
 * A raiz (`/`) e as rotas de origem (`/de/<ferramenta>`) servem exatamente esta página. A rota de
 * origem existe porque o Cloudflare Web Analytics conta por `Path` e NÃO tem dimensão de query
 * string: `?utm_source=` seria contado com a origem descartada. O caminho é o que responde "de
 * qual ferramenta esta visita veio".
 *
 * Por isso ela não é uma landing diferente — é a mesma, num endereço que o analytics sabe contar.
 * `canonical` aponta sempre para a raiz e a rota de origem sai do índice. A única diferença é
 * visual: a linha do romaneio daquela ferramenta chega marcada (ver o script no fim).
 */
import '@fontsource/doto/800.css';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';

interface Props {
  /** `true` nas rotas de origem: elas são endereço de medição, não página para indexar. */
  noindex?: boolean;
}

const { noindex = false } = Astro.props;

/* O romaneio. Só entra o que está no ar na Nipo; "homologação" é homologação, não produção.
 * `origens` liga a linha às rotas `/de/<ferramenta>` que devem abri-la marcada. */
const itens = [
  { sistema: 'Portal de Compras', uso: 'O time de compras decide reposição sobre um espelho analítico do ERP.', situacao: 'producao', origens: ['nipo-compras'] },
  { sistema: 'Painel de Logística', uso: 'Matriz e filial acompanham pedido, expedição e estoque; as TVs do galpão mostram o ritmo.', situacao: 'producao', origens: ['nipo-logistica', 'nipo-produtividade', 'nipo-painel'] },
  { sistema: 'Fotos de produto', uso: 'Upload, análise e decisão humana sobre a foto de cada item do catálogo.', situacao: 'producao', origens: ['nipo-fotos'] },
  { sistema: 'Rastreio de pedido', uso: 'O cliente final acompanha o próprio pedido por link, sem login.', situacao: 'producao', origens: ['nipo-rastreio'] },
  { sistema: 'Nipo Dados', uso: 'Claude e ChatGPT consultam os dados da Nipo e da PARI, com cada consulta registrada.', situacao: 'homologacao', origens: ['nipo-dados'] },
  { sistema: 'Painel do vendedor', uso: 'Estoque, preço e pedido na mão de quem vende.', situacao: 'homologacao', origens: ['nipo-vendas'] },
  { sistema: 'Atendimento no WhatsApp', uso: 'Autoatendimento para o cliente e console para o atendente.', situacao: 'homologacao', origens: ['nipo-atendimento'] },
];
const emProducao = itens.filter((i) => i.situacao === 'producao').length;
const dois = (n: number) => String(n).padStart(2, '0');
const emissao = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'America/Sao_Paulo' }).format(new Date());
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>carpe labs · sistemas sobre o ERP que sua empresa já tem</title>
    <meta name="description" content="Portais, integrações e IA aplicada à operação, construídos em cima do ERP que a empresa já usa. Sete sistemas entregues à Nipo Center.">
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="canonical" href="https://carpelabs.io/">
    <meta name="theme-color" content="#f3f4ee">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    {noindex && <meta name="robots" content="noindex, follow" />}
</head>
<body>
    <div class="folha">
        <header class="cabecalho">
            <a href="/" class="marca" aria-label="carpe labs, início">
                <img src="/logo-papel.png" alt="" width="720" height="531">
            </a>
            <dl class="campos">
                <div><dt>Documento</dt><dd>Romaneio de entregas</dd></div>
                <div><dt>Cliente</dt><dd>Nipo Center · São Paulo</dd></div>
                <div><dt>ERP</dt><dd>Sankhya · somente leitura</dd></div>
                <div><dt>Emissão</dt><dd>{emissao}</dd></div>
            </dl>
        </header>

        <main>
            <section class="oferta" aria-labelledby="oferta-titulo">
                <h1 id="oferta-titulo" class="matricial">Sistemas sobre o ERP que sua empresa já tem.</h1>
                <p class="oferta-texto">
                    Portais, integrações e IA aplicada à operação, construídos em cima dos seus dados.
                    Sem trocar o ERP e sem arriscar a produção.
                </p>
                <a class="carimbo" href="#solicitacao">Iniciar um projeto</a>
            </section>

            <section class="romaneio" aria-labelledby="romaneio-titulo">
                <h2 class="matricial" id="romaneio-titulo">O que já está entregue na Nipo Center</h2>
                <table>
                    <thead>
                        <tr>
                            <th scope="col" class="col-item">Item</th>
                            <th scope="col">Sistema</th>
                            <th scope="col">Para quê</th>
                            <th scope="col" class="col-situacao">Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        {itens.map((item, i) => (
                            <tr data-origens={item.origens.join(' ')} style={`--i: ${i}`}>
                                <td class="col-item matricial">{dois(i + 1)}</td>
                                <th scope="row">{item.sistema}</th>
                                <td class="col-uso">{item.uso}</td>
                                <td class={`col-situacao matricial situacao-${item.situacao}`}>
                                    {item.situacao === 'producao' ? 'Em produção' : 'Homologação'}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="col-item matricial">{dois(itens.length)}</td>
                            <td colspan="3" class="matricial">
                                Sistemas · {dois(emProducao)} em produção · {dois(itens.length - emProducao)} em homologação
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </section>

            <section class="observacoes" aria-labelledby="obs-titulo">
                <h2 class="matricial" id="obs-titulo">Como o trabalho é feito</h2>
                <ol>
                    <li>
                        <h3>O ERP continua sendo o ERP.</h3>
                        <p>Os sistemas leem o Sankhya em modo somente leitura, e cada consulta nova é medida antes de ir para produção. Nada escreve no banco do cliente sem autorização.</p>
                    </li>
                    <li>
                        <h3>Tudo passa por homologação.</h3>
                        <p>Cada versão roda antes num ambiente de teste com uma cópia dos dados reais. Só depois do aceite ela chega a quem usa, com nota do que mudou.</p>
                    </li>
                    <li>
                        <h3>IA depois dos dados, não antes.</h3>
                        <p>Primeiro os dados ficam organizados e confiáveis nos portais. Depois a IA passa a consultá-los, com limite e registro de cada consulta.</p>
                    </li>
                </ol>
            </section>

            <section id="solicitacao" class="solicitacao" aria-labelledby="solicitacao-titulo">
                <h2 class="matricial" id="solicitacao-titulo">Solicitação de projeto</h2>
                <p class="solicitacao-texto">Conte o que a sua operação precisa. A resposta vem pelo e-mail informado.</p>

                <form id="contact-form" class="formulario" novalidate>
                    <div class="campo">
                        <label for="form-name">Nome</label>
                        <input type="text" name="name" id="form-name" autocomplete="name" required>
                        <p class="field-error" id="name-error">Informe seu nome.</p>
                    </div>
                    <div class="campo">
                        <label for="form-email">E-mail</label>
                        <input type="email" name="email" id="form-email" autocomplete="email" required>
                        <p class="field-error" id="email-error">Informe um e-mail válido.</p>
                    </div>
                    <div class="campo campo-largo">
                        <label for="form-message">O que você precisa</label>
                        <textarea name="message" id="form-message" rows="5" required></textarea>
                        <p class="field-error" id="message-error">Descreva o que você precisa.</p>
                    </div>

                    <div class="envio">
                        <div class="cf-turnstile" data-sitekey="0x4AAAAAAEYqJuOOSujfYNYH" data-action="contato" data-theme="light"></div>
                        <button type="submit" class="carimbo" id="submit-btn">
                            <span id="submit-text">Enviar solicitação</span>
                            <span id="submit-loading" class="hidden">Enviando…</span>
                        </button>
                    </div>

                    <p id="form-success" class="form-message success hidden" role="status">Solicitação recebida. A resposta vai para o seu e-mail.</p>
                    <p id="form-error" class="form-message error hidden" role="alert">Não foi possível enviar. Tente de novo em instantes.</p>
                </form>
            </section>
        </main>

        <footer class="rodape">
            <a href="mailto:contact@carpelabs.io">contact@carpelabs.io</a>
            <a href="https://github.com/CarpeLabs" target="_blank" rel="noopener">GitHub</a>
            <a href="/privacidade">Privacidade</a>
            <a href="/termos">Termos</a>
        </footer>
    </div>

    <script>
        // Quem chega por `/de/<ferramenta>` vê a linha daquela ferramenta marcada.
        const daOrigem = location.pathname.match(/^\/de\/([a-z0-9-]+)/)?.[1];
        if (daOrigem) {
            const linha = document.querySelector<HTMLTableRowElement>(`.romaneio tr[data-origens~="${daOrigem}"]`);
            if (linha) {
                linha.classList.add('origem');
                const sistema = linha.querySelector('th');
                const marca = document.createElement('span');
                marca.className = 'origem-marca matricial';
                marca.textContent = 'Você veio daqui';
                sistema?.append(marca);
            }
        }

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const submitText = document.getElementById('submit-text');
        const submitLoading = document.getElementById('submit-loading');
        const nameInput = document.getElementById('form-name') as HTMLInputElement;
        const emailInput = document.getElementById('form-email') as HTMLInputElement;
        const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;
        const nameError = document.getElementById('name-error');
        const emailError = document.getElementById('email-error');
        const messageError = document.getElementById('message-error');
        const successMsg = document.getElementById('form-success');
        const errorMsg = document.getElementById('form-error');

        // Mesma origem: sem CORS, e por isso sem `no-cors` — a resposta volta legível.
        const ENDPOINT = '/api/contato';

        function validateField(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLElement | null) {
            const isValid = input.validity.valid;
            input.classList.toggle('invalid', !isValid);
            input.setAttribute('aria-invalid', String(!isValid));
            errorEl?.classList.toggle('visible', !isValid);
            return isValid;
        }

        for (const [input, errorEl] of [[nameInput, nameError], [emailInput, emailError], [messageInput, messageError]] as const) {
            input?.addEventListener('blur', () => validateField(input, errorEl));
            input?.addEventListener('input', () => { if (input.validity.valid) validateField(input, errorEl); });
        }

        form?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const isNameValid = validateField(nameInput, nameError);
            const isEmailValid = validateField(emailInput, emailError);
            const isMessageValid = validateField(messageInput, messageError);
            if (!isNameValid || !isEmailValid || !isMessageValid) {
                if (!isNameValid) nameInput?.focus();
                else if (!isEmailValid) emailInput?.focus();
                else messageInput?.focus();
                return;
            }

            successMsg?.classList.add('hidden');
            errorMsg?.classList.add('hidden');
            submitText?.classList.add('hidden');
            submitLoading?.classList.remove('hidden');
            if (submitBtn) submitBtn.disabled = true;

            const formData = new FormData(form);
            const data: Record<string, unknown> = {
                name: formData.get('name'),
                email: formData.get('email'),
                message: formData.get('message'),
                // O widget insere este campo no próprio form. Sem ele o endpoint devolve 403,
                // e é isso que se quer: sem prova, sem gravação.
                'cf-turnstile-response': formData.get('cf-turnstile-response'),
            };

            // A origem da visita (`/de/<ferramenta>`) viaja junto: é o que responde
            // "esse contato veio de qual ferramenta?" sem depender do analytics.
            if (daOrigem) data.origem = daOrigem;

            try {
                const response = await fetch(ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                });

                // 🔴 A resposta é LIDA. O código anterior usava `mode: 'no-cors'` e assumia
                // sucesso — foi assim que um 403 do endpoint virou "enviada com sucesso" na
                // tela por meses, sem ninguém saber quantas mensagens sumiram.
                if (!response.ok) {
                    const corpo = await response.json().catch(() => ({}));
                    throw new Error((corpo as { erro?: string }).erro || `Erro ${response.status}`);
                }

                successMsg?.classList.remove('hidden');
                form.reset();
            } catch (error) {
                if (errorMsg) errorMsg.textContent = error instanceof Error && error.message
                    ? error.message
                    : 'Não foi possível enviar. Tente de novo em instantes.';
                errorMsg?.classList.remove('hidden');
            } finally {
                // 🔴 Token do Turnstile é de USO ÚNICO. O formulário continua na tela depois de um
                // erro, então sem rearmar o widget a segunda tentativa mandaria um token já
                // gasto — e a pessoa levaria 403 por um problema que não é dela.
                // Há um único widget na página, então `reset()` sem argumento é inequívoco.
                (window as { turnstile?: { reset(): void } }).turnstile?.reset();
                submitText?.classList.remove('hidden');
                submitLoading?.classList.add('hidden');
                if (submitBtn) submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
