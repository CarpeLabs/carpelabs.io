---
/* A landing, em um lugar só.
 *
 * A raiz (`/`) e as rotas de origem (`/de/<ferramenta>`) servem exatamente esta página. A rota de
 * origem existe porque o Cloudflare Web Analytics conta por `Path` e NÃO tem dimensão de query
 * string: `?utm_source=` seria contado com a origem descartada. O caminho é o que responde "de
 * qual ferramenta esta visita veio".
 *
 * Por isso ela não é uma landing diferente — é a mesma, num endereço que o analytics sabe contar.
 * `canonical` aponta sempre para a raiz e a rota de origem sai do índice.
 */
import '../styles/global.css';

interface Props {
  /** `true` nas rotas de origem: elas são endereço de medição, não página para indexar. */
  noindex?: boolean;
}

const { noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carpe Labs | Software House de IA</title>
    <meta name="description" content="Transformamos ideias ambiciosas em soluções de IA prontas para produção.">
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="canonical" href="https://carpelabs.io/">
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Ambient Background -->
    <div class="ambient">
        <div class="grain"></div>
        <div class="glow glow-1"></div>
        <div class="glow glow-2"></div>
    </div>

    <!-- Main Content -->
    <main class="container">
        <!-- Logo -->
        <div class="logo-wrapper">
            <img src="/logo.png" alt="Carpe Labs" class="logo">
        </div>

        <!-- Statement -->
        <div class="content">
            <h1 class="headline">
                Construímos sistemas<br>
                <em>inteligentes</em>
            </h1>
            <p class="subtext">
                Transformamos ideias ambiciosas em soluções de IA prontas para produção.
            </p>
        </div>

        <!-- CTA -->
        <div class="actions">
            <button type="button" class="cta" id="open-modal-btn">
                <span>Iniciar um projeto</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </button>
        </div>

        <!-- Contact Modal -->
        <dialog id="contact-modal" class="modal">
            <form id="contact-form" class="modal-content">
                <button type="button" class="modal-close" id="close-modal-btn" aria-label="Fechar">&times;</button>
                <h2 class="modal-title">Iniciar um projeto</h2>
                <p class="modal-subtitle">Conte-nos sobre sua ideia</p>

                <div class="form-group">
                    <input type="text" name="name" id="form-name" placeholder="Seu nome" required>
                    <p class="field-error" id="name-error">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>Informe seu nome</span>
                    </p>
                </div>
                <div class="form-group">
                    <input type="email" name="email" id="form-email" placeholder="seu@email.com" required>
                    <p class="field-error" id="email-error">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>Informe um email válido</span>
                    </p>
                </div>
                <div class="form-group">
                    <textarea name="message" id="form-message" placeholder="Descreva seu projeto..." rows="4" required></textarea>
                    <p class="field-error" id="message-error">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>Descreva seu projeto</span>
                    </p>
                </div>

                <button type="submit" class="cta cta-submit" id="submit-btn">
                    <span id="submit-text">Enviar</span>
                    <span id="submit-loading" class="hidden">Enviando...</span>
                </button>

                <p id="form-success" class="form-message success hidden">Mensagem enviada com sucesso!</p>
                <p id="form-error" class="form-message error hidden">Erro ao enviar. Tente novamente.</p>
            </form>
        </dialog>

        <!-- Footer Links -->
        <footer class="footer">
            <a href="https://github.com/CarpeLabs" target="_blank">GitHub</a>
            <span class="divider"></span>
            <a href="mailto:contact@carpelabs.io">contact@carpelabs.io</a>
        </footer>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Glow animation
            const glow1 = document.querySelector('.glow-1');
            if (glow1) {
                let targetX = 0;
                let targetY = 0;
                let currentX = 0;
                let currentY = 0;

                document.addEventListener('mousemove', (e) => {
                    const x = e.clientX / window.innerWidth;
                    const y = e.clientY / window.innerHeight;
                    targetX = (x - 0.5) * 50;
                    targetY = (y - 0.5) * 50;
                });

                function animate() {
                    currentX += (targetX - currentX) * 0.05;
                    currentY += (targetY - currentY) * 0.05;
                    (glow1 as HTMLElement).style.transform = `translate(${currentX}px, ${currentY}px)`;
                    requestAnimationFrame(animate);
                }

                animate();
            }

            // Modal functionality
            const modal = document.getElementById('contact-modal') as HTMLDialogElement;
            const openBtn = document.getElementById('open-modal-btn');
            const closeBtn = document.getElementById('close-modal-btn');
            const form = document.getElementById('contact-form') as HTMLFormElement;
            const submitBtn = document.getElementById('submit-btn');
            const submitText = document.getElementById('submit-text');
            const submitLoading = document.getElementById('submit-loading');

            // Form fields and errors
            const nameInput = document.getElementById('form-name') as HTMLInputElement;
            const emailInput = document.getElementById('form-email') as HTMLInputElement;
            const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;
            const nameError = document.getElementById('name-error');
            const emailError = document.getElementById('email-error');
            const messageError = document.getElementById('message-error');

            // Validation helpers
            function validateField(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLElement | null) {
                const isValid = input.validity.valid;
                input.classList.toggle('invalid', !isValid);
                errorEl?.classList.toggle('visible', !isValid);
                return isValid;
            }

            function clearValidation(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLElement | null) {
                input.classList.remove('invalid');
                errorEl?.classList.remove('visible');
            }

            // Validate on blur (when leaving field)
            nameInput?.addEventListener('blur', () => validateField(nameInput, nameError));
            emailInput?.addEventListener('blur', () => validateField(emailInput, emailError));
            messageInput?.addEventListener('blur', () => validateField(messageInput, messageError));

            // Clear error on input
            nameInput?.addEventListener('input', () => {
                if (nameInput.validity.valid) clearValidation(nameInput, nameError);
            });
            emailInput?.addEventListener('input', () => {
                if (emailInput.validity.valid) clearValidation(emailInput, emailError);
            });
            messageInput?.addEventListener('input', () => {
                if (messageInput.validity.valid) clearValidation(messageInput, messageError);
            });
            const successMsg = document.getElementById('form-success');
            const errorMsg = document.getElementById('form-error');

            // Google Apps Script URL - substitua pela sua URL após deploy
            // Mesma origem: sem CORS, e por isso sem `no-cors` — a resposta volta legível.
            const ENDPOINT = '/api/contato';

            openBtn?.addEventListener('click', () => {
                // Reset validation state
                clearValidation(nameInput, nameError);
                clearValidation(emailInput, emailError);
                clearValidation(messageInput, messageError);
                modal?.showModal();
            });

            closeBtn?.addEventListener('click', () => {
                modal?.close();
            });

            modal?.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.close();
                }
            });

            form?.addEventListener('submit', async (e) => {
                e.preventDefault();

                // Validate all fields
                const isNameValid = validateField(nameInput, nameError);
                const isEmailValid = validateField(emailInput, emailError);
                const isMessageValid = validateField(messageInput, messageError);

                if (!isNameValid || !isEmailValid || !isMessageValid) {
                    // Focus first invalid field
                    if (!isNameValid) nameInput?.focus();
                    else if (!isEmailValid) emailInput?.focus();
                    else messageInput?.focus();
                    return;
                }

                // Reset messages
                successMsg?.classList.add('hidden');
                errorMsg?.classList.add('hidden');

                // Show loading
                submitText?.classList.add('hidden');
                submitLoading?.classList.remove('hidden');
                if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;

                const formData = new FormData(form);
                const data = {
                    name: formData.get('name'),
                    email: formData.get('email'),
                    message: formData.get('message')
                };

                // A origem da visita (`/de/<ferramenta>`) viaja junto: é o que responde
                // "esse contato veio de qual ferramenta?" sem depender do analytics.
                const daRota = location.pathname.match(/^\/de\/([a-z0-9-]+)/);
                if (daRota) (data as Record<string, unknown>).origem = daRota[1];

                try {
                    const response = await fetch(ENDPOINT, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data)
                    });

                    // 🔴 A resposta é LIDA. O código anterior usava `mode: 'no-cors'` e assumia
                    // sucesso — foi assim que um 403 do endpoint virou "enviada com sucesso" na
                    // tela por meses, sem ninguém saber quantas mensagens sumiram.
                    if (!response.ok) {
                        const corpo = await response.json().catch(() => ({}));
                        throw new Error((corpo as { erro?: string }).erro || `Erro ${response.status}`);
                    }

                    successMsg?.classList.remove('hidden');
                    form.reset();

                    // Close modal after 2 seconds
                    setTimeout(() => {
                        modal?.close();
                        successMsg?.classList.add('hidden');
                    }, 2000);

                } catch (error) {
                    if (errorMsg) errorMsg.textContent = error instanceof Error && error.message
                        ? error.message
                        : 'Erro ao enviar. Tente novamente.';
                    errorMsg?.classList.remove('hidden');
                } finally {
                    submitText?.classList.remove('hidden');
                    submitLoading?.classList.add('hidden');
                    if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
                }
            });
        });
    </script>
</body>
</html>
