---
/* A landing, em um lugar só.
 *
 * A raiz (`/`) e as rotas de origem (`/de/<ferramenta>`) servem exatamente esta página. A rota de
 * origem existe porque o Cloudflare Web Analytics conta por `Path` e NÃO tem dimensão de query
 * string: `?utm_source=` seria contado com a origem descartada. O caminho é o que responde "de
 * qual ferramenta esta visita veio".
 *
 * Por isso ela não é uma landing diferente — é a mesma, num endereço que o analytics sabe contar.
 * `canonical` aponta sempre para a raiz e a rota de origem sai do índice. A única diferença é
 * visual: o sistema daquela ferramenta chega marcado (ver o script no fim).
 *
 * 🔴 As telas em `public/telas/` são capturas reais dos portais da Nipo (HML, clone de produção),
 * com clientes, vendedores, pessoas, fornecedores, valores e parceiros tarjados. Cada uma foi
 * conferida pelo José em 25/09/2026 antes de publicar. Tela nova passa pela mesma conferência.
 */
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';

interface Props {
  /** `true` nas rotas de origem: elas são endereço de medição, não página para indexar. */
  noindex?: boolean;
}

const { noindex = false } = Astro.props;

/* Só entra o que está no ar na Nipo; "homologação" é homologação, não produção.
 * `origens` liga o sistema às rotas `/de/<ferramenta>` que devem abri-lo marcado. */
const comTela = [
  {
    sistema: 'Painel de Logística',
    situacao: 'producao',
    origens: ['nipo-logistica', 'nipo-produtividade', 'nipo-painel'],
    texto: 'Matriz e filial acompanham cada pedido do faturamento à expedição. O mesmo painel mostra a ocupação de cada endereço do galpão e roda nas TVs da operação.',
    telas: [
      { nome: 'fluxo', alt: 'Tabela de pedidos do painel de Logística, com situação, etapa e número de cada pedido; nomes de cliente e vendedor tarjados.', legenda: 'Fluxo de pedidos da Loja. Cliente e vendedor tarjados.', w: 1600, h: 1000,
        notas: [
          { x: 20, y: 42.2, t: 'Situação pelo tempo logístico, contado só dentro do expediente.' },
          { x: 46.8, y: 42.2, t: 'O que a operação precisa priorizar agora, pedido a pedido.' },
        ] },
      { nome: 'armazenagem', alt: 'Vista em três dimensões da armazenagem da Loja, com mezaninos, térreo e endereços coloridos pela ocupação.', legenda: 'Armazenagem da Loja em 3D: 149 endereços. Parceiro tarjado.', w: 1600, h: 1081,
        notas: [
          { x: 54.8, y: 33, t: 'Endereço acima do limite aparece em vermelho, antes de virar problema.' },
          { x: 57, y: 76, t: 'Cada andar e cada endereço do galpão, no lugar onde está.' },
        ] },
    ],
  },
  {
    sistema: 'Portal de Compras',
    situacao: 'producao',
    origens: ['nipo-compras'],
    texto: 'O time de compras decide a reposição sobre um espelho analítico do ERP, por grupo e por fornecedor.',
    telas: [
      { nome: 'compras', alt: 'Visão da carteira no portal de Compras, com produtos para decidir por grupo e ranking de fornecedores; nomes de fornecedor e valores em reais tarjados.', legenda: 'Visão da carteira. Fornecedores e valores tarjados.', w: 1600, h: 1000,
        notas: [
          { x: 62, y: 23.5, t: 'Ruptura em destaque: o que já falta na prateleira.' },
          { x: 19, y: 38, t: 'Quantas decisões cada grupo e subgrupo tem pela frente.' },
          { x: 59.2, y: 35.9, t: 'Fornecedores ordenados pela exposição: lead time × itens em ruptura.' },
        ] },
    ],
  },
];

/* Numeração contínua dentro de cada sistema: o marcador na tela e o item da legenda ao lado. */
const numerados = comTela.map((s) => {
  let n = 0;
  const telas = s.telas.map((t) => ({ ...t, notas: t.notas.map((nota) => ({ ...nota, n: ++n })) }));
  return { ...s, telas, notas: telas.flatMap((t) => t.notas) };
});

const semTela = [
  { sistema: 'Fotos de produto', situacao: 'producao', origens: ['nipo-fotos'], texto: 'Upload, análise e decisão humana sobre a foto de cada item do catálogo.' },
  { sistema: 'Rastreio de pedido', situacao: 'producao', origens: ['nipo-rastreio'], texto: 'O cliente final acompanha o próprio pedido por link, sem login.' },
  { sistema: 'Nipo Dados', situacao: 'homologacao', origens: ['nipo-dados'], texto: 'Claude e ChatGPT consultam os dados da Nipo e da PARI, com cada consulta limitada e registrada.' },
  { sistema: 'Painel do vendedor', situacao: 'homologacao', origens: ['nipo-vendas'], texto: 'Estoque, preço e pedido na mão de quem vende.' },
  { sistema: 'Atendimento no WhatsApp', situacao: 'homologacao', origens: ['nipo-atendimento'], texto: 'Autoatendimento para o cliente e console para o atendente.' },
];

const rotulo = (s: string) => (s === 'producao' ? 'Em produção' : 'Em homologação');
const srcset = (nome: string) => `/telas/${nome}-960.webp 960w, /telas/${nome}-1600.webp 1600w`;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>carpe labs · sistemas sobre o ERP que sua empresa já tem</title>
    <meta name="description" content="Portais, integrações e IA aplicada à operação, construídos em cima do ERP que a empresa já usa. O caso Nipo Center, com as telas em uso.">
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="canonical" href="https://carpelabs.io/">
    <meta name="theme-color" content="#fafaf9">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
        // Movimento de entrada. Fica no <head> e não no bundle de propósito: o CSS só esconde
        // o que vai animar quando `anima` está no <html>, e quem põe a classe é o mesmo script
        // que depois revela. Se ele não rodar, nada fica escondido.
        (function () {
            var d = document.documentElement;
            if (!('IntersectionObserver' in window)) return;
            d.classList.add('anima');
            document.addEventListener('DOMContentLoaded', function () {
                var olho = new IntersectionObserver(function (entradas) {
                    entradas.forEach(function (e) {
                        if (e.isIntersecting) { e.target.classList.add('visto'); olho.unobserve(e.target); }
                    });
                }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
                document.querySelectorAll('[data-anima]').forEach(function (el) { olho.observe(el); });

                // O topo fica fixo e ganha a régua quando a página sai do começo.
                var topo = document.querySelector('.topo');

                // Movimento ligado à rolagem: cada [data-rolagem] recebe --p (0 → 1) conforme passa
                // pela janela, e o CSS decide o que fazer com ele. Sem este script, ou com movimento
                // reduzido, --p fica no valor-padrão do CSS, que é o estado final.
                var reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
                var els = reduz ? [] : Array.prototype.slice.call(document.querySelectorAll('[data-rolagem]'));
                var pendente = false;
                var lim = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
                var suave = function (v) { return 1 - Math.pow(1 - v, 3); };
                var calcular = function () {
                    pendente = false;
                    var vh = innerHeight;
                    topo && topo.classList.toggle('rolou', scrollY > 8);
                    d.style.setProperty('--rolado', lim(scrollY / Math.max(1, d.scrollHeight - vh)).toFixed(4));
                    for (var i = 0; i < els.length; i++) {
                        var el = els[i], r = el.getBoundingClientRect(), tipo = el.getAttribute('data-rolagem'), p;
                        if (r.bottom < -vh || r.top > vh * 2) continue;
                        if (tipo === 'sai') p = lim(-r.top / (r.height * 0.85));
                        else if (tipo === 'faixa') p = lim((vh - r.top) / (vh + r.height));
                        else if (tipo === 'secao') p = suave(lim((vh - r.top) / (vh * 0.75)));
                        else p = suave(lim((vh - r.top) / (vh * 0.6)));
                        el.style.setProperty('--p', p.toFixed(4));
                    }
                };
                var pedir = function () { if (!pendente) { pendente = true; requestAnimationFrame(calcular); } };
                addEventListener('scroll', pedir, { passive: true });
                addEventListener('resize', pedir);
                calcular();
            });
        })();
    </script>
</head>
<body>
    <header class="topo">
        <a href="/" class="marca" aria-label="carpe labs, início">
            <img src="/logo-papel.png" alt="" width="720" height="531">
        </a>
        <a href="#contato" class="topo-link">Iniciar um projeto</a>
    </header>

    <main>
        <section class="abertura" data-rolagem="sai" aria-labelledby="abertura-titulo">
            <div class="abertura-texto">
                <p class="em-uso"><span class="situacao situacao-producao">Em uso na Nipo Center</span><span class="em-uso-erp">ERP Sankhya, somente leitura</span></p>
                <h1 id="abertura-titulo">Sistemas sobre o ERP que sua empresa já tem.</h1>
                <p class="abertura-apoio">
                    Portais, integrações e IA aplicada à operação, construídos em cima dos seus dados.
                    Sem trocar o ERP e sem arriscar a produção.
                </p>
                <div class="abertura-acoes">
                    <a class="botao" href="#contato"><span>Iniciar um projeto</span><svg class="seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    <a class="link" href="#caso"><span>Ver o caso Nipo Center</span><svg class="seta seta-baixo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
                </div>
            </div>
            <figure class="palco">
                <div class="palco-telas">
                    <img
                        class="palco-fundo"
                        src="/telas/fluxo-960.webp"
                        width="960" height="600"
                        alt="" aria-hidden="true">
                    <img
                        class="palco-frente"
                        src="/telas/produtividade-1600.webp"
                        srcset={srcset('produtividade')}
                        sizes="(min-width: 64rem) 55vw, 100vw"
                        width="1600" height="1000"
                        alt="Tela Quem produziu ontem, do painel de Logística da Nipo: pessoas do checkout com pedidos, carrinhos, linhas e unidades do dia; nomes tarjados."
                        fetchpriority="high">
                </div>
                <figcaption>Painel de Logística da Nipo Center, em uso. Nomes de pessoas e clientes tarjados.</figcaption>
            </figure>
        </section>

        <div class="faixa" data-rolagem="faixa" aria-hidden="true">
            <p class="faixa-linha faixa-sistemas">{[0, 1].map(() => comTela.map((c) => c.sistema).concat(semTela.map((c) => c.sistema)).map((n) => <span>{n}</span>))}</p>
            <p class="faixa-linha faixa-lema">{Array.from({ length: 6 }, () => <span>sobre o ERP que já existe</span>)}</p>
        </div>

        <section id="caso" class="caso" aria-labelledby="caso-titulo">
            <div class="caso-intro">
                <div class="caso-intro-texto" data-rolagem="sobe">
                    <h2 id="caso-titulo" data-anima="titulo">O caso Nipo Center</h2>
                    <p>
                        A Nipo Center é uma importadora de São Paulo que roda sobre o ERP Sankhya. Em vez de
                        trocar o sistema, ela ganhou portais que leem o ERP em modo somente leitura e
                        entregam a cada área a tela que faltava. Em cima desses dados, a IA passa a consultar
                        a operação.
                    </p>
                </div>

                <figure class="camadas" data-anima="camadas" aria-label="As duas camadas construídas sobre o ERP">
                    <div class="camada camada-ia">
                        <p class="camada-nome">IA aplicada à operação</p>
                        <p class="camada-desc">Claude e ChatGPT consultam os dados, com limite e registro.</p>
                        <ul class="camada-itens"><li class="homolog">Nipo Dados</li></ul>
                    </div>
                    <p class="camada-liga"><span>consulta</span></p>
                    <div class="camada camada-portais">
                        <p class="camada-nome">Portais e integrações</p>
                        <p class="camada-desc">A tela que faltava para cada área.</p>
                        <ul class="camada-itens"><li>Logística</li><li>Compras</li><li>Fotos</li><li>Rastreio</li></ul>
                    </div>
                    <p class="camada-liga"><span>lê, sem escrever</span></p>
                    <div class="camada camada-erp">
                        <p class="camada-nome">ERP Sankhya</p>
                        <p class="camada-desc">Continua sendo o sistema da empresa. Nada é trocado.</p>
                    </div>
                </figure>
            </div>

            {numerados.map((s) => (
                <article class="sistema" data-origens={s.origens.join(' ')}>
                    <div class="sistema-texto" data-anima="texto">
                        <h3>{s.sistema}</h3>
                        <p class={`situacao situacao-${s.situacao}`}>{rotulo(s.situacao)}</p>
                        <p class="sistema-uso">{s.texto}</p>
                        <ol class="notas">
                            {s.notas.map((nota) => (
                                <li data-n={nota.n}><span class="notas-n" aria-hidden="true">{nota.n}</span>{nota.t}</li>
                            ))}
                        </ol>
                    </div>
                    <div class="sistema-telas">
                        {s.telas.map((t) => (
                            <figure data-rolagem="cresce">
                                <div class="tela" data-anima="tela">
                                    <img
                                        src={`/telas/${t.nome}-1600.webp`}
                                        srcset={srcset(t.nome)}
                                        sizes="(min-width: 64rem) 65vw, 100vw"
                                        width={t.w} height={t.h}
                                        alt={t.alt}
                                        loading="lazy" decoding="async">
                                    {t.notas.map((nota) => (
                                        <span class="marcador" data-n={nota.n} style={`left: ${nota.x}%; top: ${nota.y}%; --ordem: ${nota.n}`} aria-hidden="true">{nota.n}</span>
                                    ))}
                                </div>
                                <figcaption>{t.legenda}</figcaption>
                            </figure>
                        ))}
                    </div>
                </article>
            ))}

            <div class="outros" data-rolagem="sobe">
                <h3>Também entregues</h3>
                <ul data-anima="lista">
                    {semTela.map((s) => (
                        <li data-origens={s.origens.join(' ')}>
                            <span class="outros-nome">{s.sistema}</span>
                            <span class="outros-uso">{s.texto}</span>
                            <span class={`situacao situacao-${s.situacao}`}>{rotulo(s.situacao)}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <section class="metodo" data-rolagem="secao" aria-labelledby="metodo-titulo">
            <h2 id="metodo-titulo" data-rolagem="sobe">Como o trabalho é feito</h2>
            <div class="metodo-itens" data-anima="lista">
                <div>
                    <h3>O ERP continua sendo o ERP.</h3>
                    <p>Os sistemas leem o Sankhya em modo somente leitura, e cada consulta nova é medida antes de ir para produção. Nada escreve no banco do cliente sem autorização.</p>
                </div>
                <div>
                    <h3>Tudo passa por homologação.</h3>
                    <p>Cada versão roda antes num ambiente de teste com uma cópia dos dados reais. Só depois do aceite ela chega a quem usa, com nota do que mudou.</p>
                </div>
                <div>
                    <h3>IA depois dos dados, não antes.</h3>
                    <p>Primeiro os dados ficam organizados e confiáveis nos portais. Depois a IA passa a consultá-los, com limite e registro de cada consulta.</p>
                </div>
            </div>
        </section>

        <section id="contato" class="contato" data-rolagem="secao" aria-labelledby="contato-titulo">
          <div class="contato-grade">
            <div class="contato-intro">
                <h2 id="contato-titulo" data-anima="titulo">Iniciar um projeto</h2>
                <p>Conte o que a sua operação precisa e qual ERP ela usa. A resposta vem pelo e-mail informado.</p>
                <p class="contato-alt">Prefere e-mail? <a href="mailto:contact@carpelabs.io">contact@carpelabs.io</a></p>
            </div>

            <form id="contact-form" class="formulario" novalidate>
                <div class="campo">
                    <label for="form-name">Nome</label>
                    <input type="text" name="name" id="form-name" autocomplete="name" required>
                    <p class="field-error" id="name-error">Informe seu nome.</p>
                </div>
                <div class="campo">
                    <label for="form-email">E-mail</label>
                    <input type="email" name="email" id="form-email" autocomplete="email" required>
                    <p class="field-error" id="email-error">Informe um e-mail válido.</p>
                </div>
                <div class="campo campo-largo">
                    <label for="form-message">O que você precisa</label>
                    <textarea name="message" id="form-message" rows="5" required></textarea>
                    <p class="field-error" id="message-error">Descreva o que você precisa.</p>
                </div>

                <div class="envio">
                    <div class="cf-turnstile" data-sitekey="0x4AAAAAAEYqJuOOSujfYNYH" data-action="contato" data-theme="dark"></div>
                    <button type="submit" class="botao" id="submit-btn">
                        <span id="submit-text">Enviar</span><svg class="seta" id="submit-seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        <span id="submit-loading" class="hidden">Enviando…</span>
                    </button>
                </div>

                <p id="form-success" class="form-message success hidden" role="status">Mensagem recebida. A resposta vai para o seu e-mail.</p>
                <p id="form-error" class="form-message error hidden" role="alert">Não foi possível enviar. Tente de novo em instantes.</p>
            </form>
          </div>
        </section>
    </main>

    <footer class="rodape">
        <img src="/logo-papel.png" alt="carpe labs" width="720" height="531" class="rodape-marca">
        <nav aria-label="Links do rodapé">
            <a href="mailto:contact@carpelabs.io">contact@carpelabs.io</a>
            <a href="https://github.com/CarpeLabs" target="_blank" rel="noopener">GitHub</a>
            <a href="/privacidade">Privacidade</a>
            <a href="/termos">Termos</a>
        </nav>
    </footer>

    <script>
        // Quem chega por `/de/<ferramenta>` vê o sistema daquela ferramenta marcado.
        const daOrigem = location.pathname.match(/^\/de\/([a-z0-9-]+)/)?.[1];
        if (daOrigem) {
            const alvo = document.querySelector<HTMLElement>(`[data-origens~="${daOrigem}"]`);
            if (alvo) {
                alvo.classList.add('origem');
                const marca = document.createElement('span');
                marca.className = 'origem-marca';
                marca.textContent = 'Você veio daqui';
                alvo.querySelector('h3, .outros-nome')?.append(marca);
            }
        }

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const submitText = document.getElementById('submit-text');
        const submitLoading = document.getElementById('submit-loading');
        const nameInput = document.getElementById('form-name') as HTMLInputElement;
        const emailInput = document.getElementById('form-email') as HTMLInputElement;
        const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;
        const nameError = document.getElementById('name-error');
        const emailError = document.getElementById('email-error');
        const messageError = document.getElementById('message-error');
        const successMsg = document.getElementById('form-success');
        const errorMsg = document.getElementById('form-error');

        // Mesma origem: sem CORS, e por isso sem `no-cors` — a resposta volta legível.
        const ENDPOINT = '/api/contato';

        function validateField(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLElement | null) {
            const isValid = input.validity.valid;
            input.classList.toggle('invalid', !isValid);
            input.setAttribute('aria-invalid', String(!isValid));
            errorEl?.classList.toggle('visible', !isValid);
            return isValid;
        }

        for (const [input, errorEl] of [[nameInput, nameError], [emailInput, emailError], [messageInput, messageError]] as const) {
            input?.addEventListener('blur', () => validateField(input, errorEl));
            input?.addEventListener('input', () => { if (input.validity.valid) validateField(input, errorEl); });
        }

        form?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const isNameValid = validateField(nameInput, nameError);
            const isEmailValid = validateField(emailInput, emailError);
            const isMessageValid = validateField(messageInput, messageError);
            if (!isNameValid || !isEmailValid || !isMessageValid) {
                if (!isNameValid) nameInput?.focus();
                else if (!isEmailValid) emailInput?.focus();
                else messageInput?.focus();
                return;
            }

            successMsg?.classList.add('hidden');
            errorMsg?.classList.add('hidden');
            submitText?.classList.add('hidden');
            document.getElementById('submit-seta')?.classList.add('hidden');
            submitLoading?.classList.remove('hidden');
            if (submitBtn) submitBtn.disabled = true;

            const formData = new FormData(form);
            const data: Record<string, unknown> = {
                name: formData.get('name'),
                email: formData.get('email'),
                message: formData.get('message'),
                // O widget insere este campo no próprio form. Sem ele o endpoint devolve 403,
                // e é isso que se quer: sem prova, sem gravação.
                'cf-turnstile-response': formData.get('cf-turnstile-response'),
            };

            // A origem da visita (`/de/<ferramenta>`) viaja junto: é o que responde
            // "esse contato veio de qual ferramenta?" sem depender do analytics.
            if (daOrigem) data.origem = daOrigem;

            try {
                const response = await fetch(ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                });

                // 🔴 A resposta é LIDA. O código anterior usava `mode: 'no-cors'` e assumia
                // sucesso — foi assim que um 403 do endpoint virou "enviada com sucesso" na
                // tela por meses, sem ninguém saber quantas mensagens sumiram.
                if (!response.ok) {
                    const corpo = await response.json().catch(() => ({}));
                    throw new Error((corpo as { erro?: string }).erro || `Erro ${response.status}`);
                }

                successMsg?.classList.remove('hidden');
                form.reset();
            } catch (error) {
                if (errorMsg) errorMsg.textContent = error instanceof Error && error.message
                    ? error.message
                    : 'Não foi possível enviar. Tente de novo em instantes.';
                errorMsg?.classList.remove('hidden');
            } finally {
                // 🔴 Token do Turnstile é de USO ÚNICO. O formulário continua na tela depois de um
                // erro, então sem rearmar o widget a segunda tentativa mandaria um token já
                // gasto — e a pessoa levaria 403 por um problema que não é dela.
                // Há um único widget na página, então `reset()` sem argumento é inequívoco.
                (window as { turnstile?: { reset(): void } }).turnstile?.reset();
                submitText?.classList.remove('hidden');
                document.getElementById('submit-seta')?.classList.remove('hidden');
                submitLoading?.classList.add('hidden');
                if (submitBtn) submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
