---
/* Cartão de visita virtual da Carpe Labs (empresa, não pessoa): o que se mostra numa reunião ou
 * num evento. A pessoa aponta a câmera para o QR, salva o contato com um toque ou abre o site.
 *
 * Fica fora do sitemap e com noindex: é um atalho de contato, não uma página para busca. O vCard
 * é `public/carpe-labs.vcf`; o `_headers` o serve como `text/vcard` para o celular abrir a agenda. */
import '@fontsource-variable/hanken-grotesk';
import fonteLatina from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import QRCode from 'qrcode';

const ENDERECO = 'https://carpelabs.io/cartao/';
// O QR é gerado no build, em SVG, com a cor do texto sobre o fundo: nada roda no celular.
const qr = await QRCode.toString(ENDERECO, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#0b0c0e', light: '#0000' } });

const titulo = 'Carpe Labs · cartão de visita';
const descricao = 'Colocamos a IA para trabalhar na sua operação. Salve o contato da Carpe Labs.';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{titulo}</title>
    <meta name="description" content={descricao}>
    <meta name="robots" content="noindex, follow">
    <link rel="canonical" href={ENDERECO}>
    <link rel="preload" href={fonteLatina} as="font" type="font/woff2" crossorigin>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#f4f4f1">
    <meta property="og:type" content="profile">
    <meta property="og:site_name" content="Carpe Labs">
    <meta property="og:url" content={ENDERECO}>
    <meta property="og:title" content={titulo}>
    <meta property="og:description" content={descricao}>
    <meta property="og:image" content="https://carpelabs.io/og-ia.png">
    <meta name="twitter:card" content="summary_large_image">
</head>
<body>
<Fragment set:html={'<!--email_off-->'} />
<main class="cartao">
    <header class="marca">
        <svg viewBox="480 470 930 680" fill="none" stroke="currentColor" stroke-width="48" aria-hidden="true">
            <path d="M512 848 C650 702 955 628 1165 765"/>
            <path d="M1325 668 C1290 820 1150 960 958 985"/>
            <path d="M828 962 C860 1050 920 1100 1000 1108"/>
            <path fill="currentColor" stroke="none" fill-rule="evenodd" d="M826 648 C880 568 955 520 1045 497 C1028 570 1035 635 1080 688 L826 648 Z M890 645 C925 610 955 588 985 573 C988 610 993 637 1003 660 Z"/>
            <circle cx="713" cy="820" r="35" fill="currentColor" stroke="none"/>
            <circle cx="1320" cy="928" r="57" fill="currentColor" stroke="none"/>
        </svg>
        <span>carpe labs</span>
    </header>

    <h1>Colocamos a <span class="forte">IA</span> para trabalhar na sua operação.</h1>
    <p class="apoio">Assistentes de IA em cima do sistema que a sua empresa já usa. São Paulo, atendendo todo o Brasil.</p>

    <nav class="acoes" aria-label="Contato">
        <a class="botao" href="/carpe-labs.vcf" download="Carpe Labs.vcf">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14"/></svg>
            Salvar contato
        </a>
        <a class="linha" href="mailto:contact@carpelabs.io">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17z M4 7l8 6 8-6"/></svg>
            <span><small>E-mail</small>contact@carpelabs.io</span>
        </a>
        <a class="linha" href="/#contato">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm-8.5 8.5h17M12 3.5c2.4 2.3 3.6 5.2 3.6 8.5s-1.2 6.2-3.6 8.5c-2.4-2.3-3.6-5.2-3.6-8.5s1.2-6.2 3.6-8.5Z"/></svg>
            <span><small>Site</small>carpelabs.io</span>
        </a>
        <a class="linha" href="https://github.com/CarpeLabs" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8.5 8-4 4 4 4m7-8 4 4-4 4M13.5 5.5l-3 13"/></svg>
            <span><small>GitHub</small>github.com/CarpeLabs</span>
        </a>
    </nav>

    <figure class="qr">
        <div class="qr-codigo" set:html={qr} />
        <figcaption>Aponte a câmera para abrir este cartão.</figcaption>
    </figure>

    <button class="compartilhar" type="button" id="compartilhar" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m0 0L7.5 8.5M12 4l4.5 4.5M5 13v6.5h14V13"/></svg>
        <span>Compartilhar cartão</span>
    </button>
</main>
<Fragment set:html={'<!--email_on-->'} />

<script is:inline>
    // Compartilhar: a folha nativa do celular quando existe; senão, copia o endereço.
    (function () {
        var b = document.getElementById('compartilhar');
        if (!b) return;
        var texto = b.querySelector('span');
        var dados = { title: 'Carpe Labs', text: 'Colocamos a IA para trabalhar na sua operação.', url: 'https://carpelabs.io/cartao/' };
        if (!navigator.share && !(navigator.clipboard && navigator.clipboard.writeText)) return;
        b.hidden = false;
        b.addEventListener('click', function () {
            if (navigator.share) { navigator.share(dados).catch(function () {}); return; }
            navigator.clipboard.writeText(dados.url).then(function () {
                texto.textContent = 'Link copiado';
                setTimeout(function () { texto.textContent = 'Compartilhar cartão'; }, 2000);
            });
        });
    })();
</script>

<style is:global>
    :root {
        --fundo: #f4f4f1; --fundo-2: #e9e9e4; --texto: #0b0c0e; --texto-2: #50545c; --texto-3: #686d75;
        --regua: rgb(11 12 14 / 0.12); --verde: #2e6b55; --verde-escuro: #24563f;
        --fonte: 'Hanken Grotesk Variable', system-ui, sans-serif;
        color-scheme: light;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--fonte); background: var(--fundo); color: var(--texto); -webkit-font-smoothing: antialiased; line-height: 1.5; }
    a { color: inherit; text-decoration: none; }

    .cartao { width: min(100%, 26rem); margin: 0 auto; min-height: 100dvh; padding: clamp(1.75rem, 6vw, 3rem) 1.25rem 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
    .marca { display: flex; align-items: center; gap: 0.6rem; color: var(--verde); font-size: 1.25rem; letter-spacing: -0.01em; }
    .marca svg { width: 2.4rem; height: auto; }
    h1 { margin-top: 0.5rem; font-size: clamp(2.1rem, 9vw, 2.6rem); font-weight: 300; line-height: 1.04; letter-spacing: -0.04em; text-wrap: balance; }
    .forte { font-weight: 500; color: var(--verde); }
    .apoio { color: var(--texto-2); font-size: 1.0625rem; }

    .acoes { display: grid; gap: 0.5rem; }
    .acoes svg { width: 1.25rem; height: 1.25rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
    .botao { display: flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 3.25rem; border-radius: 999px; background: var(--verde); color: #fff; font-weight: 600; font-size: 1.0625rem; margin-bottom: 0.5rem; transition: background 200ms, transform 120ms; }
    .botao:hover { background: var(--verde-escuro); }
    .botao:active { transform: scale(0.97); }
    .linha { display: flex; align-items: center; gap: 0.9rem; min-height: 3.75rem; padding: 0.6rem 1rem; border-radius: 1rem; background: var(--fundo-2); transition: background 200ms; }
    .linha:hover { background: #e1e1db; }
    .linha svg { color: var(--verde); }
    .linha span { display: grid; line-height: 1.25; font-weight: 500; overflow-wrap: anywhere; }
    .linha small { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--texto-3); }

    .qr { display: grid; justify-items: center; gap: 0.75rem; padding: 1.5rem 1rem 1.25rem; border: 1px solid var(--regua); border-radius: 1.25rem; }
    .qr-codigo { width: 11rem; aspect-ratio: 1; }
    .qr-codigo svg { width: 100%; height: 100%; display: block; }
    .qr figcaption { font-size: 0.875rem; color: var(--texto-3); text-align: center; }

    .compartilhar { display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 3rem; border: 1px solid var(--regua); border-radius: 999px; background: transparent; font: inherit; font-weight: 500; color: var(--texto); cursor: pointer; }
    .compartilhar[hidden] { display: none; }
    .compartilhar svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
    :focus-visible { outline: 2px solid var(--verde); outline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) { .botao, .linha { transition: none; } }
</style>
</body>
</html>
